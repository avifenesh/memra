+// Research-only NVTX attribution. No stream synchronization or math changes.
+fn verify_tally_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("MEMRA_GLM5_VERIFY_TALLY").as_deref() == Ok("1"))
+}
+
+pub(crate) struct VerifyTallyRange(bool);
+impl VerifyTallyRange {
+    pub(crate) fn new(name: impl FnOnce() -> String) -> Self {
+        let on = verify_tally_on();
+        if on {
+            let name = std::ffi::CString::new(name()).expect("tally range name");
+            unsafe {
+                crate::dsv4_ffi::memra_dsv4_nvtx_push(name.as_ptr());
+            }
+        }
+        Self(on)
+    }
+}
+impl Drop for VerifyTallyRange {
+    fn drop(&mut self) {
+        if self.0 {
+            unsafe {
+                crate::dsv4_ffi::memra_dsv4_nvtx_pop();
+            }
+        }
+    }
+}
