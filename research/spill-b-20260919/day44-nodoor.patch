-                &kd,
-                &vd,
-                &gd,
-                &bd,
-                None,
-                None,
-                &sid,
-                &mut sod,
-                &mut od,
-                h,
-                t,
-                scale,
-                c,
-                h,
-                Some((rows, &mut slot)),
-            )
