diff -ruN -x day61-box.sh -x __pycache__ orig/research/spill-c-20260919/maxq-verdict.py kit/tree/research/spill-c-20260919/maxq-verdict.py
--- orig/research/spill-c-20260919/maxq-verdict.py	1970-01-01 02:00:00.000000000 +0200
+++ kit/tree/research/spill-c-20260919/maxq-verdict.py	2026-11-04 21:16:45.017553522 +0200
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""DAY59 rule over one card's four readings (DAY59.md:48-49, quoted in PREREG.md), one VERDICT line.
+
+"PF becomes that card's naked default iff G1, G2 and G3 pass there, `pftime` reads `pf_wins` and `pfnaked` does
+not read `pf_loses`". The inputs are the unchanged day59-pf.py readings (<out>/<cell>/reading.log); nothing is
+re-measured here. Outcomes: qualifies; does-not-qualify (a gate failed, which voids the timing verdict, or the rule
+is not met); void (a reading is missing or a timing cell's integrity failed: no decision, rerun).
+
+usage: maxq-verdict.py <out-dir> [--rig NAME] [--card N] [--power-limit W]
+"""
+import re
+import sys
+from pathlib import Path
+
+
+def opt(name, default):
+    return sys.argv[sys.argv.index(name) + 1] if name in sys.argv else default
+
+
+def read(path):
+    try:
+        return path.read_text(errors="replace").splitlines()
+    except FileNotFoundError:
+        return None
+
+
+def main():
+    out = Path(sys.argv[1])
+    rig, card, plim = opt("--rig", "?"), opt("--card", "?"), opt("--power-limit", "?")
+    logs = {c: read(out / c / "reading.log") for c in ("pfgates", "pfserve", "pftime", "pfnaked")}
+    missing = [c for c, ls in logs.items() if ls is None]
+
+    def result(cell, prefix):
+        hits = [l for l in (logs[cell] or []) if l.startswith(prefix)]
+        return [l.rsplit("-> ", 1)[-1].strip() for l in hits]
+
+    g1 = result("pfgates", "DAY59 G1 ")
+    g1 = "PASS" if len(g1) == 2 and all(r == "PASS" for r in g1) else ("missing" if not g1 else "FAIL")
+    g2 = (result("pfgates", "DAY59 G2 ") or ["missing"])[0]
+    g3 = (result("pfserve", "DAY59 G3 ") or ["missing"])[0]
+    shapes = {}
+    for cell in ("pftime", "pfnaked"):
+        line = next((l for l in (logs[cell] or []) if l.startswith(f"DAY59 VERDICT rig={rig} shape={cell} ")
+                     or re.match(rf"DAY59 VERDICT rig=\S+ shape={cell} ", l)), None)
+        m = re.search(r"integrity=(\S+) -> (\S+)$", line) if line else None
+        shapes[cell] = (m.group(1), m.group(2)) if m else ("missing", "void")
+    gates = [g1, g2, g3]
+    integrity_ok = all(shapes[c][0] == "ok" for c in shapes)
+    if missing or "missing" in gates or not integrity_ok:
+        name = "void"
+    elif any(g != "PASS" for g in gates):
+        name = "does-not-qualify"
+    elif shapes["pftime"][1] == "pf_wins" and shapes["pfnaked"][1] != "pf_loses":
+        name = "qualifies"
+    else:
+        name = "does-not-qualify"
+    print(f"DAY59 VERDICT rig={rig} card={card} power_limit={plim} g1={g1} g2={g2} g3={g3}"
+          f" pftime={shapes['pftime'][1]} pfnaked={shapes['pfnaked'][1]}"
+          + (f" missing={','.join(missing)}" if missing else "") + f" -> {name}")
+    return 0 if name != "void" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
