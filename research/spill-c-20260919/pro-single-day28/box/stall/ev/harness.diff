+EXACT_PROMPT = [None]  # WP-C day 28: the on-grid seed prompt of the restore-exact arm, set in setup
+GRID = 32
+
+
+def tokcount(port, prompt):
+    """WP-C day 28: `/v1/tokenize` count of a prompt (no prime, no cache effect); the model's default
+    add_special mirrors /v1/completions (the hit gate's `tokcount`)."""
+    c = http.client.HTTPConnection("127.0.0.1", port, timeout=60)
+    c.request("POST", "/v1/tokenize", body=json.dumps({"model": "gate", "prompt": prompt}),
+              headers={"Content-Type": "application/json"})
+    r = c.getresponse()
+    data = r.read()
+    c.close()
+    if r.status != 200:
+        raise RuntimeError(f"tokenize HTTP {r.status}: {data[:200]!r}")
+    return json.loads(data)["count"]
+
+
+def ongrid_prompt(port, base):
+    """WP-C day 28: `base` plus ` ok` words until the count is a multiple of GRID (the hit gate's
+    `ongrid_prompt`: each ` ok` is one token on the BPE tokenizers here; corrects up to three times)."""
+    count = tokcount(port, base)
+    pad = (GRID - count % GRID) % GRID
+    for _ in range(3):
+        p = base + " ok" * pad
+        count = tokcount(port, p)
+        if count % GRID == 0:
+            return p, count, pad
+        pad += (GRID - count % GRID) % GRID
+    raise RuntimeError(f"could not build an on-grid prompt (last count {count})")
+
