--- /dev/null
+++ b/crates/memra-engine/src/ple_rows_tier/device.rs
@@ -0,0 +1,72 @@
+//! Qualification-only native upload and exclusive handback. The exact sealed
+//! allocation is handed to the existing PLE projections without another H2D/D2D
+//! copy. The ticket's explicit consumer is a byte-check D2H; subsequent native
+//! projection lifetime/accounting belongs to the returned cudarc allocation.
+use crate::ple_rows_tier::*;
+use crate::{Engine, tier_transfer::CudaTransfers};
+use cudarc::driver::CudaSlice;
+use memra_tier::contracts::*;
+
+impl PleRowsTier {
+    pub(crate) fn upload_device(
+        &self,
+        e: &Engine,
+        rows: &GatheredRows,
+    ) -> std::result::Result<CudaSlice<f32>, Box<dyn std::error::Error>> {
+        let mut transfers = CudaTransfers::new(e.stream().clone(), self.budget.clone())?;
+        let bytes: Vec<u8> = rows
+            .iter()
+            .flat_map(|v| v.to_bits().to_le_bytes())
+            .collect();
+        let request = BudgetRequest {
+            bytes: TierBudget::zero(1),
+            priority: Priority::Demand,
+            deadline: Deadline(u64::MAX),
+            tenant: digest("ple-native-device-gate-v1", &[]),
+        };
+        let mut host = transfers.alloc_host(bytes.len(), request.clone())?;
+        host.write(&bytes)?;
+        let epochs = Epochs {
+            state: 0,
+            src_gen: 0,
+            dst_gen: 0,
+        };
+        let device = transfers.alloc_device(bytes.len(), epochs.dst_gen, request)?;
+        let op = CopyOp {
+            host,
+            device,
+            bytes: bytes.len() as u64,
+            epochs,
+            producer_fence: None,
+        };
+        let mut upload = rows
+            .submit_device(&mut transfers, op)
+            .map_err(|r| r.error)?;
+        transfers.synchronize(&upload.ticket())?;
+        let lease = upload.publish(&mut transfers, epochs)?;
+        let copied =
+            transfers.with_destination(&upload.ticket(), 0, epochs, |device, stream| {
+                stream.clone_dtoh(device).map_err(|_| Error::Corrupt)
+            })?;
+        if copied != bytes {
+            return Err("device-publish: sealed row bytes differ".into());
+        }
+        let done = transfers.record_consumer(&upload.ticket())?;
+        transfers.synchronize(&upload.ticket())?;
+        if !upload.retire(&mut transfers, Some(done))? {
+            return Err("device-publish: consumer not retired".into());
+        }
+        upload.acknowledge(&mut transfers)?;
+        let raw = transfers.take_device(&lease)?;
+        if raw.len() != rows.len() * 4 {
+            return Err("device-publish: handback length differs".into());
+        }
+        // SAFETY: exclusive handback of a CUDA allocation aligned for f32, exactly
+        // N*4 initialized bytes copied from F32 bits (all f32 bit patterns valid).
+        // take_device synchronized prior CUDA uses, and leak transfers ownership
+        // exactly once into the same owner stream's typed allocation.
+        let out = unsafe { e.stream().upgrade_device_ptr::<f32>(raw.leak(), rows.len()) };
+        self.device_uploads.set(self.device_uploads.get() + 1);
+        Ok(out)
+    }
+}
