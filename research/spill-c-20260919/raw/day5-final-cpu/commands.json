[
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "mac-check",
    "command": [
      "cargo",
      "check",
      "-p",
      "memra-tier",
      "--offline",
      "--all-targets"
    ],
    "exit_code": 0
  },
  {
    "name": "linux-target-check",
    "command": [
      "cargo",
      "check",
      "-p",
      "memra-tier",
      "--offline",
      "--all-targets",
      "--target",
      "x86_64-unknown-linux-gnu"
    ],
    "exit_code": 0
  },
  {
    "name": "tier-tests",
    "command": [
      "cargo",
      "test",
      "-p",
      "memra-tier",
      "--offline",
      "--no-fail-fast"
    ],
    "exit_code": 0
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "-p",
      "memra-tier",
      "--offline",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "diff-check",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "flags",
    "command": [
      "bash",
      "tools/check-flags.sh"
    ],
    "exit_code": 0
  }
]
