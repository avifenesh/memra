+    #[test]
+    fn randomized_training_depths_keep_exposure_and_survive_a_new_request() {
+        let mut p = LearnedDepth::randomized(4, 20774000).unwrap();
+        let mut chosen = Vec::new();
+        for round in 0..128 {
+            if round == 64 {
+                p.begin_request("another turn");
+            }
+            p.prepare_output(&[11, 12]).unwrap();
+            let depth = p.depth();
+            chosen.push(depth - 1);
+            p.observe_output(depth, 0, &[11], Duration::from_millis(1), true)
+                .unwrap();
+        }
+        assert!(chosen.iter().all(|depth| (1..=4).contains(depth)));
+        for depth in 1..=4 {
+            assert!(chosen.iter().filter(|&&action| action == depth).count() >= 16);
+        }
+        assert_eq!(p.stats().iter().map(|s| s.rounds).sum::<u64>(), 128);
+        assert!(p.switches() > 0);
+    }
+}
