+    #[test]
+    fn randomized_training_depths_keep_exposure_and_survive_a_new_request() {
+        let mut p = LearnedDepth::randomized(4, 20774000).unwrap();
+        let mut chosen = Vec::new();
+        for round in 0..128 {
+            if round == 64 {
+                p.begin_request("another turn");
+            }
+            p.prepare_output(&[11, 12]).unwrap();
+            let depth = p.depth();
+            chosen.push(depth - 1);
+            p.observe_output(depth, 0, &[11], Duration::from_millis(1), true)
+                .unwrap();
+        }
+        assert!(chosen.iter().all(|depth| (1..=4).contains(depth)));
+        for depth in 1..=4 {
+            assert!(chosen.iter().filter(|&&action| action == depth).count() >= 16);
+        }
+        assert_eq!(p.stats().iter().map(|s| s.rounds).sum::<u64>(), 128);
+        assert!(p.switches() > 0);
+    }
+    #[test]
+    fn tiny_depth_uses_only_available_token_and_noop_pays_inference() {
+        let mut text = "joint-v4-linear\t1\ttoken\t4\t100\t100\n".to_string();
+        for d in 1..=4 {
+            let mut accepted = [0.0_f64; 23];
+            if d == 3 {
+                accepted[0] = 2.0;
+            }
+            if d == 4 {
+                accepted[1] = 4.0;
+            }
+            let mut ms = [0.0_f64; 23];
+            ms[0] = 10.0;
+            for (kind, weights) in [("A", accepted), ("T", ms)] {
+                text.push_str(&format!(
+                    "{kind}\t{d}\t{}\n",
+                    weights.iter().map(ToString::to_string).collect::<Vec<_>>().join(",")
+                ));
+            }
+        }
+        text.push_str("B\t42\t0\n");
+        let model = TinyDepthModel::parse(&text).unwrap();
+        let mut learned = LearnedDepth::trained(model.clone(), false);
+        learned.prepare_output(&[42]).unwrap();
+        assert_eq!(learned.depth(), 5);
+        learned.observe_output(5, 0, &[42], Duration::from_millis(10), true).unwrap();
+        learned.begin_request("next user turn");
+        learned.prepare_output(&[17]).unwrap();
+        assert_eq!(learned.depth(), 4);
+        let mut noop = LearnedDepth::trained(model, true);
+        noop.prepare_output(&[42]).unwrap();
+        assert_eq!(noop.depth(), 4);
+        assert!(noop.inference_ns() > 0);
+    }
+}
