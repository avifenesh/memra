+    /// Called only after the sampled draft token has been offered.
+    pub fn confidence_stop(&mut self, position: usize, q: f32) -> Result<bool, &'static str> {
+        let Some(confidence) = &mut self.confidence else {
+            return Ok(false);
+        };
+        if position >= 3 || !q.is_finite() || !(0.0..=1.0).contains(&q) {
+            return Err("invalid offered confidence position or probability");
+        }
+        let started = Instant::now();
+        let chance = confidence.model.accepted_chance(
+            position, &confidence.features, q,
+        );
+        confidence.chain *= chance;
+        let expected_gain = confidence.chain * confidence.model.next_rate[position];
+        let expected_cost = confidence.model.lambda
+            * confidence.model.marginal_ms[position] / 1000.0;
+        let stop = expected_gain < expected_cost;
+        std::hint::black_box(stop);
+        confidence.decisions += 1;
+        if stop && !confidence.noop {
+            confidence.stops += 1;
+        }
+        confidence.inference_ns += started.elapsed().as_nanos();
+        Ok(stop && !confidence.noop)
+    }
