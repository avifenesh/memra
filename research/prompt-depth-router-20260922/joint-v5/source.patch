 mod depth_study_io;
 
+struct KRouter {
+    features: usize,
+    window_size: usize,
+    weights: Vec<(i32, [f64; 11])>,
+}
+
+impl KRouter {
+    fn parse(text: &str) -> Result<Self, &'static str> {
+        let mut lines = text.lines();
+        let header: Vec<_> = lines
+            .next()
+            .ok_or("missing sampler K model header")?
+            .split('\t')
+            .collect();
+        if header.len() != 5 || header[0] != "joint-v5-topk" || header[1] != "1" {
+            return Err("invalid sampler K model header");
+        }
+        let (features, window_size) = match header[2] {
+            "first16" => (10, 16),
+            "first32" => (10, 32),
+            "prior" => (11, 32),
+            _ => return Err("unknown sampler K feature version"),
+        };
+        let lambda: f64 = header[3].parse().map_err(|_| "invalid K target rate")?;
+        let alpha: f64 = header[4].parse().map_err(|_| "invalid K fit penalty")?;
+        if !lambda.is_finite() || lambda <= 0.0 || !alpha.is_finite() || alpha <= 0.0 {
+            return Err("invalid K rate or fit penalty");
+        }
+        let mut weights = Vec::new();
+        for line in lines {
+            let fields: Vec<_> = line.split('\t').collect();
+            if fields.len() != 3 || fields[0] != "K" {
+                return Err("invalid sampler K action row");
+            }
+            let k: i32 = fields[1].parse().map_err(|_| "invalid sampled K action")?;
+            if !matches!(k, 3 | 10 | 20) || weights.iter().any(|(old, _)| *old == k) {
+                return Err("duplicate or unsupported sampler K action");
+            }
+            let coefficients = fields[2]
+                .split(',')
+                .map(|value| value.parse::<f64>().map_err(|_| "invalid K weight"))
+                .collect::<Result<Vec<_>, _>>()?;
+            if coefficients.len() != features || coefficients.iter().any(|w| !w.is_finite()) {
+                return Err("sampler K weights differ from feature version");
+            }
+            let mut row = [0.0; 11];
+            row[..features].copy_from_slice(&coefficients);
+            weights.push((k, row));
+        }
+        if !weights.iter().any(|(k, _)| *k == 20) {
+            return Err("sampler K model lacks recommended default action");
+        }
+        Ok(Self { features, window_size, weights })
+    }
+
+    fn select(&self, prefix: &[u32], previous_accept: Option<f64>) -> i32 {
+        let mut x = [0.0; 11];
+        x[0] = 1.0;
+        let count = self.window_size;
+        let window = &prefix[..prefix.len().min(count)];
+        if !window.is_empty() {
+            for &token in window {
+                let bucket = token.wrapping_mul(0x9e37_79b1) % 8;
+                x[1 + bucket as usize] += 1.0 / window.len() as f64;
+            }
+        }
+        x[9] = window.len() as f64 / count as f64;
+        if self.features == 11 {
+            x[10] = previous_accept.unwrap_or(0.0);
+        }
+        let value = |row: &[f64; 11]| {
+            row[..self.features]
+                .iter()
+                .zip(x)
+                .map(|(weight, feature)| weight * feature)
+                .sum::<f64>()
+        };
+        let mut best = 20;
+        let mut best_score = value(
+            &self.weights.iter().find(|(k, _)| *k == 20).expect("checked K20").1,
+        );
+        for (k, row) in &self.weights {
+            let score = value(row);
+            if score > best_score + 1e-9 {
+                best = *k;
+                best_score = score;
+            }
+        }
+        std::hint::black_box(best_score);
+        best
+    }
+}
