 //! Explicit study policies: a fixed control or a persistent contextual controller.
 use std::sync::Arc;
 use std::time::Duration;
+use std::collections::HashMap;
+use std::time::Instant;
+
+const DEPTH_FEATURES: usize = 37;
+
+fn feature_vector(
+    variant: usize,
+    classes: &HashMap<u32, u8>,
+    output: &[u32],
+    prior: Option<(f64, f64)>,
+) -> [f64; DEPTH_FEATURES] {
+    let class = |token: u32| usize::from(*classes.get(&token).unwrap_or(&5));
+    let mut x = [0.0; DEPTH_FEATURES];
+    x[0] = 1.0;
+    if let Some(&last) = output.last() {
+        x[1 + class(last)] = 1.0;
+        x[7 + (last.wrapping_mul(0x9e37_79b1) % 16) as usize] = 1.0;
+    }
+    if variant >= 35 {
+        for (start, size) in [(23, 4), (29, 16)] {
+            let n = output.len().min(size);
+            if n > 0 {
+                for &token in output.iter().rev().take(size) {
+                    x[start + class(token)] += 1.0 / n as f64;
+                }
+            }
+        }
+    }
+    if variant == 37 {
+        if let Some((accepted, ms)) = prior {
+            x[35] = accepted;
+            x[36] = (ms / 80.0).min(1.0);
+        }
+    }
+    x
+}
+
+#[derive(Clone, Debug)]
+pub struct TinyDepthModel {
+    variant: usize,
+    lambda: f64,
+    accepted: [[f64; DEPTH_FEATURES]; 4],
+    elapsed_ms: [[f64; DEPTH_FEATURES]; 4],
+    classes: HashMap<u32, u8>,
+}
+
+impl TinyDepthModel {
+    pub fn parse(text: &str) -> Result<Self, &'static str> {
+        let mut lines = text.lines();
+        let header: Vec<_> = lines.next().ok_or("missing tiny depth header")?.split('\t').collect();
+        if header.len() != 6 || header[0] != "joint-v4-linear" || header[1] != "1"
+            || header[3] != "4"
+        {
+            return Err("invalid tiny depth header");
+        }
+        let variant = match header[2] {
+            "token" => 23,
+            "history" => 35,
+            "prior" => 37,
+            _ => return Err("unknown tiny depth feature version"),
+        };
+        let lambda: f64 = header[4].parse().map_err(|_| "invalid tiny depth target rate")?;
+        let alpha: f64 = header[5].parse().map_err(|_| "invalid tiny depth penalty")?;
+        if !lambda.is_finite() || lambda <= 0.0 || !alpha.is_finite() || alpha <= 0.0 {
+            return Err("nonpositive tiny depth rate or penalty");
+        }
+        let mut model = Self {
+            variant,
+            lambda,
+            accepted: [[0.0; DEPTH_FEATURES]; 4],
+            elapsed_ms: [[0.0; DEPTH_FEATURES]; 4],
+            classes: HashMap::new(),
+        };
+        let mut seen = [[false; 4]; 2];
+        for line in lines {
+            let fields: Vec<_> = line.split('\t').collect();
+            if fields.len() != 3 {
+                return Err("invalid tiny depth row");
+            }
+            match fields[0] {
+                "A" | "T" => {
+                    let d: usize = fields[1].parse().map_err(|_| "invalid tiny depth action")?;
+                    if !(1..=4).contains(&d) {
+                        return Err("tiny depth action outside 1..=4");
+                    }
+                    let kind = usize::from(fields[0] == "T");
+                    if seen[kind][d - 1] {
+                        return Err("duplicate tiny depth weight row");
+                    }
+                    let weights = fields[2]
+                        .split(',')
+                        .map(|value| value.parse::<f64>().map_err(|_| "invalid tiny depth weight"))
+                        .collect::<Result<Vec<_>, _>>()?;
+                    if weights.len() != variant || weights.iter().any(|w| !w.is_finite()) {
+                        return Err("tiny depth weights differ from the feature version");
+                    }
+                    let target = if kind == 0 {
+                        &mut model.accepted[d - 1]
+                    } else {
+                        &mut model.elapsed_ms[d - 1]
+                    };
+                    target[..variant].copy_from_slice(&weights);
+                    seen[kind][d - 1] = true;
+                }
+                "B" => {
+                    let token: u32 = fields[1].parse().map_err(|_| "invalid tiny depth token id")?;
+                    let class: u8 = fields[2].parse().map_err(|_| "invalid tiny depth token class")?;
+                    if class >= 6 || model.classes.insert(token, class).is_some() {
+                        return Err("duplicate or invalid tiny depth token class");
+                    }
+                }
+                _ => return Err("unknown tiny depth row kind"),
+            }
+        }
+        if seen.iter().flatten().any(|&value| !value) {
+            return Err("tiny depth lacks a learned action");
+        }
+        Ok(model)
+    }
+
+    fn features(&self, output: &[u32], prior: Option<(f64, f64)>) -> [f64; DEPTH_FEATURES] {
+        feature_vector(self.variant, &self.classes, output, prior)
+    }
+
+    fn score(&self, d: usize, x: &[f64; DEPTH_FEATURES]) -> f64 {
+        let dot = |weights: &[f64; DEPTH_FEATURES]| {
+            weights[..self.variant].iter().zip(x).map(|(w, v)| w * v).sum::<f64>()
+        };
+        let accepted = dot(&self.accepted[d - 1]).clamp(0.0, d as f64);
+        let ms = dot(&self.elapsed_ms[d - 1]).max(0.01);
+        1.0 + accepted - self.lambda * ms / 1000.0
+    }
+}
+
+#[derive(Clone, Debug)]
+struct TinyDepthPolicy {
+    model: Arc<TinyDepthModel>,
+    noop: bool,
+    current_depth: usize,
+    prior: Option<(f64, f64)>,
+    switches: u64,
+    inference_ns: u128,
+}
+
+#[derive(Clone, Debug)]
+pub struct TinyConfidenceModel {
+    variant: usize,
+    lambda: f64,
+    weights: [[f64; DEPTH_FEATURES + 1]; 3],
+    next_rate: [f64; 3],
+    marginal_ms: [f64; 3],
+    classes: HashMap<u32, u8>,
+}
+
+impl TinyConfidenceModel {
+    pub fn parse(text: &str) -> Result<Self, &'static str> {
+        let mut lines = text.lines();
+        let header: Vec<_> = lines
+            .next()
+            .ok_or("missing tiny confidence header")?
+            .split('\t')
+            .collect();
+        if header.len() != 4 || header[0] != "joint-v4-confidence" || header[1] != "1" {
+            return Err("invalid tiny confidence header");
+        }
+        let variant = match header[2] {
+            "token" => 23,
+            "history" => 35,
+            "prior" => 37,
+            _ => return Err("unknown tiny confidence feature version"),
+        };
+        let lambda: f64 = header[3].parse().map_err(|_| "invalid tiny confidence rate")?;
+        if !lambda.is_finite() || lambda <= 0.0 {
+            return Err("invalid tiny confidence target rate");
+        }
+        let mut model = Self {
+            variant,
+            lambda,
+            weights: [[0.0; DEPTH_FEATURES + 1]; 3],
+            next_rate: [0.0; 3],
+            marginal_ms: [0.0; 3],
+            classes: HashMap::new(),
+        };
+        let mut seen = [false; 3];
+        for line in lines {
+            let fields: Vec<_> = line.split('\t').collect();
+            match fields.first().copied() {
+                Some("C") if fields.len() == 5 => {
+                    let position: usize = fields[1]
+                        .parse()
+                        .map_err(|_| "invalid confidence decision position")?;
+                    if position >= 3 || seen[position] {
+                        return Err("duplicate or unknown confidence position");
+                    }
+                    let next: f64 = fields[2]
+                        .parse()
+                        .map_err(|_| "invalid next-slot acceptance rate")?;
+                    let ms: f64 = fields[3]
+                        .parse()
+                        .map_err(|_| "invalid confidence marginal cost")?;
+                    if !next.is_finite() || !(0.0..=1.0).contains(&next) || !ms.is_finite() {
+                        return Err("invalid confidence marginal evidence");
+                    }
+                    let weights = fields[4]
+                        .split(',')
+                        .map(|value| value.parse::<f64>().map_err(|_| "invalid confidence weight"))
+                        .collect::<Result<Vec<_>, _>>()?;
+                    if weights.len() != variant + 1 || weights.iter().any(|w| !w.is_finite()) {
+                        return Err("confidence weights differ from the feature version");
+                    }
+                    model.weights[position][..variant + 1].copy_from_slice(&weights);
+                    model.next_rate[position] = next;
+                    model.marginal_ms[position] = ms;
+                    seen[position] = true;
+                }
+                Some("B") if fields.len() == 3 => {
+                    let token: u32 = fields[1]
+                        .parse()
+                        .map_err(|_| "invalid confidence token id")?;
+                    let class: u8 = fields[2]
+                        .parse()
+                        .map_err(|_| "invalid confidence token class")?;
+                    if class >= 6 || model.classes.insert(token, class).is_some() {
+                        return Err("duplicate or invalid confidence token class");
+                    }
+                }
+                _ => return Err("invalid tiny confidence row"),
+            }
+        }
+        if seen.iter().any(|&value| !value) {
+            return Err("tiny confidence lacks a learned stop position");
+        }
+        Ok(model)
+    }
+
+    fn features(&self, output: &[u32], prior: Option<(f64, f64)>) -> [f64; DEPTH_FEATURES] {
+        feature_vector(self.variant, &self.classes, output, prior)
+    }
+
+    fn accepted_chance(
+        &self,
+        position: usize,
+        features: &[f64; DEPTH_FEATURES],
+        q: f32,
+    ) -> f64 {
+        let q = f64::from(q).clamp(1e-6, 1.0 - 1e-6);
+        let q_logit = (q / (1.0 - q)).ln().clamp(-12.0, 12.0) / 12.0;
+        let row = &self.weights[position];
+        let value: f64 = row[..self.variant]
+            .iter()
+            .zip(features)
+            .map(|(w, x)| w * x)
+            .sum::<f64>()
+            + row[self.variant] * q_logit;
+        if value >= 0.0 {
+            1.0 / (1.0 + (-value).exp())
+        } else {
+            let exponent = value.exp();
+            exponent / (1.0 + exponent)
+        }
+    }
+}
+
