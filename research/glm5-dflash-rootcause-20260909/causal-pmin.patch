+        let mut legacy = [0.0_f64; 2];
+        let mut causal = [0.0_f64; 2];
+        for token in 0..2 {
+            for (out, keep) in [
+                (&mut legacy, glm5_conf_keep(&[1.0, q[token] as f32], 0.7, false)),
+                (&mut causal, selector_confidence_keep(&rows, 2, 2, 0.7, false)),
+            ] {
+                if keep == 1 {
+                    for i in 0..2 {
