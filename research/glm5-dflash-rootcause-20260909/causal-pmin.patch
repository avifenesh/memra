+/// Opt-in correction: decide whether to verify a sampled selector slot from its
+/// distribution, before conditioning on which token was drawn. The legacy chosen-q
+/// cutoff censors rare proposals without changing the rejection sampler's q.
+fn glm5_causal_pmin() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("MEMRA_GLM5_SPEC_CAUSAL_PMIN").as_deref() == Ok("1"))
+}
+
+fn selector_confidence_keep(q_rows: &[f32], top_k: usize, k: usize, p_min: f32, pmin0: bool) -> usize {
+    assert!(top_k > 0 && q_rows.len() / top_k >= k);
+    let confidence: Vec<f32> = q_rows
+        .chunks_exact(top_k)
+        .take(k)
+        .map(|row| row.iter().copied().fold(0.0, f32::max))
+        .collect();
+    glm5_conf_keep(&confidence, p_min, pmin0)
+}
