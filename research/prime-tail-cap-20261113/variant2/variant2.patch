+    #[test]
+    fn a_cap_row_call_leaves_buffers_every_folded_call_fits() {
+        // memra#1258: a prompt of 4,097 to 4,111 tokens folds its short tail into one call wider
+        // than the cap; the slab and the tap sink a cap-row call sized must hold it, or the call
+        // allocates a whole new slab (and a fresh sink) beside the cached ones.
+        let cap = crate::cache::PRIME_CHUNK_MAX_TOKENS;
+        let held = super::prime_call_buffer_rows(cap);
+        for t in cap..cap + PRIME_MIN_T + 40 {
+            for gdn_grid in [false, true] {
+                let fixed = fixed_prime_chunk_ranges(t, cap, false);
+                let ranges = if gdn_grid {
+                    align_prime_ranges_to_gdn(&fixed, t, 64)
+                } else {
+                    fixed
+                };
+                let widest = ranges.iter().map(|&(s, e)| e - s).max().unwrap();
+                assert!(
+                    widest <= held,
+                    "t={t} gdn_grid={gdn_grid}: widest call {widest} > {held}"
+                );
+            }
+        }
+        assert_eq!(super::prime_call_buffer_rows(cap + PRIME_MIN_T - 1), held);
+        // Shorter and explicit monolithic calls keep their own size.
+        assert_eq!(super::prime_call_buffer_rows(cap - 1), cap - 1);
+        assert_eq!(super::prime_call_buffer_rows(128), 128);
+        assert_eq!(
+            super::prime_call_buffer_rows(cap + PRIME_MIN_T),
+            cap + PRIME_MIN_T
+        );
+    }
