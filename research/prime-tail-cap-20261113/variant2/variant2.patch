+/// Rows the resident prime slab (`HybridModel::prime_slabs_get`) and a DFlash prime call's tap
+/// sink are sized for when a call of `t` rows needs them (memra#1258). A call at the chunk cap
+/// takes `PRIME_CHUNK_MAX_TOKENS + PRIME_MIN_T - 1` rows: the widest call the ring-off tail fold of
+/// `fixed_prime_chunk_ranges` makes. A folded call of 4,097 to 4,111 rows (a prompt of that length)
+/// then fits the slab a cap-row call left, instead of allocating a whole new slab beside it, and
+/// its tap sink matches the cap-row sink the pool cached. Any other call keeps its own row count.
+pub fn prime_call_buffer_rows(t: usize) -> usize {
+    let cap = crate::cache::PRIME_CHUNK_MAX_TOKENS;
+    if (cap..cap + PRIME_MIN_T).contains(&t) {
+        cap + PRIME_MIN_T - 1
+    } else {
+        t
+    }
+}
