+            admit_yield: true,
+            entry: true,
+            entry_yields,
+            tok: &tok,
+            decoded_visible: Vec::new(),
+            cursor: 0,
+            emit_remaining: 64,
+            eos_seen: false,
+            send_ok: true,
+            token_events: 0,
+            flush_tx: tx.clone(),
+            eos_ids: Vec::new(),
+            stop_ids: Vec::new(),
