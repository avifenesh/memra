+/// ENTRY-YIELD BOUND (memra#1201). A burst's first commit hook runs before its first round.
+/// When a request waits for admission the hook says stop there, and the burst runs no round.
+/// A burst that entered on a carried pending token has emitted nothing at that point, so a
+/// session that holds one made no progress at all in that burst, and under arrivals that
+/// keep coming it made none for as long as they came: a greedy request emitted 1 to 3 tokens
+/// in a 20 to 30 s window where the same request without a carried token advances one token
+/// per burst (`research/spec-entry-yield-bound-20261110/`). The bound: a session may yield at
+/// its burst entry with nothing emitted at most this many times in a row; its next burst runs
+/// one round before it yields. Running a round where the burst would have yielded moves no
+/// token: where a burst ends is content-neutral (the burst-boundary and seeded-invariance
+/// gates).
+/// PROBE (measurement build only). The arms' knobs, read from the file named by
+/// `PROBE1201_KNOBS` (re-read at most every 200 ms, so one boot can run every arm), lines
+/// `N=<u32>` (the entry-yield bound; absent = unbounded), `STARVED=<m>` (arm b: when the cost
+/// model owns the gate, a session whose last m bursts each yielded at their entry with nothing
+/// emitted is priced at its realized rate over them, zero, and demotes; absent = off) and
+/// `FLUSH=1` (the flush arm: a continuation that would yield at its entry while it holds a
+/// carried token first flushes the token, so the entry emits the next one) and `SLOT=1` (the
+/// slot arm of b: a session's second and later silent entry yield in a row puts a zero-rate
+/// sample into the cost model's realized slot at (this tick's live sessions, its K)) and
+/// `BAND=1` (the LOW/HIGH band owns the gate, as `MEMRA_SPEC_GATE_MODEL=0` at boot).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ProbeKnobs {
+    n: u32,
+    starved: Option<u32>,
+    flush: bool,
+    slot: bool,
+    band: bool,
+}
+
+/// PROBE: the live session count of this tick's demotion sweep (the slot arm's n).
+static PROBE_N_LIVE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+fn probe_knobs() -> ProbeKnobs {
+    type Slot = Option<(Instant, ProbeKnobs)>;
+    static K: std::sync::Mutex<Slot> = std::sync::Mutex::new(None);
+    let off = ProbeKnobs {
+        n: u32::MAX,
+        starved: None,
+        flush: false,
+        slot: false,
+        band: false,
+    };
+    let Ok(path) = std::env::var("PROBE1201_KNOBS") else {
+        return off;
+    };
+    let mut slot = K.lock().unwrap();
+    if let Some((at, k)) = *slot
+        && at.elapsed() < std::time::Duration::from_millis(200)
+    {
+        return k;
+    }
+    let mut k = off;
+    for line in std::fs::read_to_string(&path).unwrap_or_default().lines() {
+        match line.trim().split_once('=') {
+            Some(("N", v)) => k.n = v.trim().parse().unwrap_or(u32::MAX),
+            Some(("STARVED", v)) => k.starved = v.trim().parse().ok().filter(|&m: &u32| m >= 1),
+            Some(("FLUSH", v)) => k.flush = v.trim() == "1",
+            Some(("SLOT", v)) => k.slot = v.trim() == "1",
+            Some(("BAND", v)) => k.band = v.trim() == "1",
+            _ => {}
+        }
+    }
+    if slot.is_none_or(|(_, old)| old != k) {
+        eprintln!("[spec-yield] PROBE knobs now {k:?}");
+    }
+    *slot = Some((Instant::now(), k));
+    k
+}
+
+fn spec_entry_yield_max() -> u32 {
+    probe_knobs().n
+}
+
+fn spec_starved_yields() -> Option<u32> {
+    probe_knobs().starved
+}
+
+fn spec_yield_flush_arm() -> bool {
+    probe_knobs().flush
+}
