# the byte gate of the several-token decode call: chat cases below the window, one sequence across it, two long ones
verify-rows gsm $LANE/dec/ids/gsm.prompt.i32 $LANE/dec/ids/gsm.gen.i32
verify-rows code $LANE/dec/ids/code.prompt.i32 $LANE/dec/ids/code.gen.i32
verify-rows copy $LANE/dec/ids/copy.prompt.i32 $LANE/dec/ids/copy.gen.i32
verify-rows story $LANE/dec/ids/story.prompt.i32 $LANE/dec/ids/story.gen.i32
verify-rows hebrew_para $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/dec/ids/hebrew_para.gen.i32
verify-rows code_pal $LANE/dec/ids/code_pal.prompt.i32 $LANE/dec/ids/code_pal.gen.i32
verify-rows sys_json $LANE/dec/ids/sys_json.prompt.i32 $LANE/dec/ids/sys_json.gen.i32
verify-rows gsm_think $LANE/dec/ids/gsm_think.prompt.i32 $LANE/dec/ids/gsm_think.gen.i32
verify-rows cross128 $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/spec/ids/cross128.force.i32
verify-rows cross128odd $LANE/dec/ids/story.prompt.i32 $LANE/spec/ids/cross128.force.i32
verify-rows needle $LANE/dec/ids/needle.prompt.i32 $LANE/spec/ids/cross128.force.i32
verify-rows decode32k_he_summary $LANE/dec/ids/decode32k_he_summary.prompt.i32 $LANE/dec/ids/decode32k_he_summary.gen.i32
verify-rows decode64k_en_continue $LANE/dec/ids/decode64k_en_continue.prompt.i32 $LANE/dec/ids/decode64k_en_continue.gen.i32
