# how a verification step's time grows with its rows, and steady-state acceptance on a low- and a high-acceptance case
gen story_d5 $LANE/dec/ids/story.prompt.i32 128
gen code_pal_d5 $LANE/dec/ids/code_pal.prompt.i32 96
gen code_pal_d1 $LANE/dec/ids/code_pal.prompt.i32 96 1
gen code_pal_d2 $LANE/dec/ids/code_pal.prompt.i32 96 2
gen code_pal_d3 $LANE/dec/ids/code_pal.prompt.i32 96 3
gen code_pal_d4 $LANE/dec/ids/code_pal.prompt.i32 96 4
gen story_d2 $LANE/dec/ids/story.prompt.i32 128 2
