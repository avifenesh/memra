# the row term on a 9-layer resident trunk (one sequence, 1..N rows)
rows-time short $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/spec/ids/cross128.force.i32 12
rows-time needle $LANE/dec/ids/needle.prompt.i32 $LANE/spec/ids/cross128.force.i32 12
verify-rows cross128 $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/spec/ids/cross128.force.i32
verify-rows needle $LANE/dec/ids/needle.prompt.i32 $LANE/spec/ids/cross128.force.i32
batch-rows chat8 $LANE/dec/ids/gsm.prompt.i32 $LANE/dec/ids/gsm.gen.i32 $LANE/dec/ids/code.prompt.i32 $LANE/dec/ids/code.gen.i32 $LANE/dec/ids/copy.prompt.i32 $LANE/dec/ids/copy.gen.i32 $LANE/dec/ids/story.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/dec/ids/hebrew_para.gen.i32 $LANE/dec/ids/code_pal.prompt.i32 $LANE/dec/ids/code_pal.gen.i32 $LANE/dec/ids/sys_json.prompt.i32 $LANE/dec/ids/sys_json.gen.i32 $LANE/dec/ids/gsm_think.prompt.i32 $LANE/dec/ids/gsm_think.gen.i32
batch-rows window $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/story.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/gsm_think.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/capital.prompt.i32 $LANE/spec/ids/cross128.force.i32
batch-rows mixed $LANE/dec/ids/gsm.prompt.i32 $LANE/dec/ids/gsm.gen.i32 $LANE/dec/ids/needle.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/story.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/needle1200.prompt.i32 $LANE/dec/ids/hebrew_para.gen.i32 $LANE/dec/ids/code.prompt.i32 $LANE/dec/ids/code.gen.i32
batch-rows nine $LANE/dec/ids/gsm.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/code.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/copy.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/story.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/code_pal.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/sys_json.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/gsm_think.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/capital.prompt.i32 $LANE/dec/ids/story.gen.i32
batch-time chat8 24 $LANE/dec/ids/gsm.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/code.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/copy.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/story.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/code_pal.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/sys_json.prompt.i32 $LANE/spec/ids/cross128.force.i32 $LANE/dec/ids/gsm_think.prompt.i32 $LANE/spec/ids/cross128.force.i32
batch-time distinct8 24 $LANE/dec/ids/gsm.prompt.i32 $LANE/dec/ids/code.gen.i32 $LANE/dec/ids/code.prompt.i32 $LANE/dec/ids/copy.gen.i32 $LANE/dec/ids/copy.prompt.i32 $LANE/dec/ids/story.gen.i32 $LANE/dec/ids/story.prompt.i32 $LANE/dec/ids/hebrew_para.gen.i32 $LANE/dec/ids/hebrew_para.prompt.i32 $LANE/dec/ids/code_pal.gen.i32 $LANE/dec/ids/code_pal.prompt.i32 $LANE/dec/ids/gsm_think.gen.i32 $LANE/dec/ids/sys_json.prompt.i32 $LANE/dec/ids/decode32k_he_summary.gen.i32 $LANE/dec/ids/gsm_think.prompt.i32 $LANE/dec/ids/decode64k_en_continue.gen.i32
draft-tape gsm $LANE/spec/tapes-raw/gsm
draft-tape code $LANE/spec/tapes-raw/code
draft-tape copy $LANE/spec/tapes-raw/copy
draft-tape story $LANE/spec/tapes-raw/story
draft-tape hebrew_para $LANE/spec/tapes-raw/hebrew_para
draft-tape code_pal $LANE/spec/tapes-raw/code_pal
draft-tape sys_json $LANE/spec/tapes-raw/sys_json
draft-tape gsm_think $LANE/spec/tapes-raw/gsm_think
draft-tape needle $LANE/spec/tapes-raw/needle
draft-tape capital $LANE/spec/tapes-raw/capital
draft-tape hebrew $LANE/spec/tapes-raw/hebrew
draft-tape multiturn $LANE/spec/tapes-raw/multiturn
