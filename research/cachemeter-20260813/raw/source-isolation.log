+#[allow(clippy::too_many_arguments)]
+fn validate_prefix_plane_shape(
+    entry_pos: usize,
+    restore_len: usize,
+    src_len: usize,
+    src_k_tok_bytes: usize,
+    src_v_tok_bytes: usize,
+    src_k_bytes: usize,
+    src_v_bytes: usize,
+    dst_k_tok_bytes: usize,
+    dst_v_tok_bytes: usize,
+    dst_k_bytes: usize,
+    dst_v_bytes: usize,
