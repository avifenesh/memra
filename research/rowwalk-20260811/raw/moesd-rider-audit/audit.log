  4668	    /// Reduced-matrix admission for increment 1. This deliberately does not change the PP-2
  4669	    /// serving policy: the worker calls it only after `MEMRA_SPEC_PIPE=1` and an explicit spec
  4670	    /// session already exist.
  4671	    pub fn spec_pipe_available(&self, e: &Engine) -> bool {
  4672	        if std::env::var("MEMRA_SPEC_PIPE").as_deref() != Ok("1")
  4673	            || !spec_devacc()
  4674	            || std::env::var("MEMRA_SPEC_REPLAY").is_ok()
  4675	            || spec_stream()
  4676	            || std::env::var("MEMRA_SPEC_ADAPT").as_deref() == Ok("1")
  4677	            || std::env::var("MEMRA_SPEC_PMIN0").as_deref() == Ok("1")
  4678	            || std::env::var("MEMRA_SPEC_PP_ANATOMY").as_deref() == Ok("1")
  4679	            || std::env::var("MEMRA_SPEC_PMIN")
  4680	                .ok()
  4681	                .and_then(|v| v.parse::<f32>().ok())
  4682	                .unwrap_or(0.0) > 0.0
  4683	            || self.is_gemma4_e4b()
  4684	            || self.cfg.gemma4.is_some()
  4685	            || self.mtp.is_none()
  4686	        {
  4687	            return false;
  4688	        }
  4689	        let Some(cuts) = crate::pp::pp_cuts(self.layers.len()) else {
  4690	            return false;
  4691	        };
  4692	        if cuts.len() != 3 || crate::pp::pp2_streams_off() || !crate::pp::spec_pp_on() {
  4693	            return false;
  4694	        }
  4695	        crate::pp::PpNRt::get(e)
  4696	            .map(|rt| rt.n_stages() == 2 && rt.cross_device())
  4697	            .unwrap_or(false)
  4698	    }
