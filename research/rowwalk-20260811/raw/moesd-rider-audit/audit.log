  4700	    /// Two warm greedy continuation bursts over one PP-2 interval coordinator. The two existing
  4701	    /// `generate_spec_inner2` call stacks own all per-session round locals; only phase issue order
  4702	    /// changes. No callback is accepted in increment 1 — the worker publishes each completed burst.
  4703	    #[allow(clippy::too_many_arguments)]
  4704	    pub fn generate_spec_session_pair(
  4705	        &self,
  4706	        e: &Engine,
  4707	        sess_a: &mut SpecSession,
  4708	        max_new_a: usize,
  4709	        k_a: usize,
  4710	        sess_b: &mut SpecSession,
  4711	        max_new_b: usize,
  4712	        k_b: usize,
  4713	    ) -> Result<
  4714	        ((Vec<u32>, usize, usize), (Vec<u32>, usize, usize)),
  4715	        Box<dyn std::error::Error>,
  4716	    > {
  4717	        if !self.spec_pipe_available(e) {
  4718	            return Err("two-session speculative pipeline is outside its reduced matrix".into());
  4719	        }
  4720	        if max_new_a == 0 || max_new_b == 0 || k_a == 0 || k_b == 0 {
  4721	            return Err("two-session speculative pipeline requires non-empty positive-K bursts".into());
  4722	        }
  4723	        for sess in [&*sess_a, &*sess_b] {
  4724	            if sess.committed.is_empty()
  4725	                || sess.last_h.is_none()
  4726	                || (sess.next_pred.is_none() && sess.pending_tok.is_none())
  4727	            {
  4728	                return Err("two-session speculative pipeline requires warm continuations".into());
  4729	            }
