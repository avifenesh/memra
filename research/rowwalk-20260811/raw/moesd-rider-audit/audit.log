  6108	fn spec_pipe_pairable(
  6109	    engine: &Engine,
  6110	    loaded: &HashMap<String, LoadedModel>,
  6111	    a: &Session,
  6112	    b: &Session,
  6113	) -> bool {
  6114	    if std::env::var("MEMRA_SPEC_PIPE").as_deref() != Ok("1")
  6115	        || a.model != b.model
  6116	        || a.spec_k == 0
  6117	        || a.spec_k != b.spec_k
  6118	        || a.spec.is_none()
  6119	        || b.spec.is_none()
  6120	        || !a.prefill_done
  6121	        || !b.prefill_done
  6122	        || !a.prefill_queue.is_empty()
  6123	        || !b.prefill_queue.is_empty()
  6124	        || a.generated.is_empty()
  6125	        || b.generated.is_empty()
  6126	        || !a.sampler.is_greedy()
  6127	        || !b.sampler.is_greedy()
  6128	        || a.constraint.is_some()
  6129	        || b.constraint.is_some()
  6130	        || a.generated.len() >= a.budget
  6131	        || b.generated.len() >= b.budget
  6132	    {
  6133	        return false;
  6134	    }
  6135	    for sess in [a.spec.as_ref().unwrap(), b.spec.as_ref().unwrap()] {
  6136	        if sess.committed_len() == 0 || (sess.next_pred.is_none() && !sess.has_pending()) {
  6137	            return false;
  6138	        }
  6139	    }
  6140	    loaded[&a.model].model.spec_pipe_available(engine)
  6141	}
