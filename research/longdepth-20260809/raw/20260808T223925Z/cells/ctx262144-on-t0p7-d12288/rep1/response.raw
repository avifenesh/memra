{"model":"step35","text":"<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Atlas Operations Manual</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nhtml{scroll-behavior:smooth}\nbody{font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;line-height:1.6;color:#1a1a1a;background:#f5f7fa;display:flex;flex-direction:column;min-height:100vh}\na{color:#0b5cff;text-decoration:none}\na:focus,a:hover{text-decoration:underline}\nheader{position:sticky;top:0;z-index:100;background:#0f172a;color:#fff;padding:0.75rem 1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}\nheader h1{font-size:1.25rem;font-weight:700;letter-spacing:0.02em}\nheader .search{display:flex;align-items:center;gap:0.5rem}\nheader input[type=\"search\"]{padding:0.45rem 0.6rem;border-radius:4px;border:1px solid #334155;background:#1e293b;color:#f1f5f9;min-width:220px}\nheader button{background:#0b5cff;color:#fff;border:none;padding:0.45rem 0.7rem;border-radius:4px;cursor:pointer;font-weight:600}\nheader button:focus{outline:2px solid #93c5fd;outline-offset:2px}\n.layout{display:flex;flex:1}\n.sidebar{width:260px;background:#fff;border-right:1px solid #e2e8f0;padding:1rem;position:sticky;top:56px;height:calc(100vh - 56px);overflow:auto}\n.sidebar nav ul{list-style:none}\n.sidebar nav li{margin:0.25rem 0}\n.sidebar nav a{display:block;padding:0.35rem 0.5rem;border-radius:4px;color:#334155}\n.sidebar nav a:focus,.sidebar nav a:hover{background:#eef2ff;text-decoration:none}\n.sidebar nav a.active{background:#e0e7ff;color:#1e40af;font-weight:600}\nmain{flex:1;padding:1.5rem;max-width:1200px}\nsection{margin-bottom:2.5rem;padding:1.25rem;background:#fff;border:1px solid #e2e8f0;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,0.03)}\nsection h2{font-size:1.15rem;margin-bottom:0.5rem;color:#0f172a}\nsection p{margin:0.35rem 0;color:#334155}\nsection dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.5rem 1rem;margin:0.75rem 0}\nsection dt{font-weight:600;color:#0f172a}\nsection dd{color:#475569}\nsection table{width:100%;border-collapse:collapse;margin:0.75rem 0;font-size:0.95rem}\nsection table caption{font-weight:600;text-align:left;margin-bottom:0.4rem}\nsection th,section td{border:1px solid #cbd5e1;padding:0.4rem 0.6rem;text-align:left}\nsection th{background:#f8fafc;font-weight:600}\nsection tr:nth-child(even){background:#f8fafc}\nsection pre{background:#0f172a;color:#e2e8f0;padding:0.75rem;border-radius:6px;overflow:auto;font-size:0.9rem;line-height:1.4}\nsection .actions{display:flex;gap:0.5rem;margin-top:0.75rem;flex-wrap:wrap}\nsection button{padding:0.45rem 0.75rem;border:none;border-radius:4px;cursor:pointer;font-weight:600;background:#0f172a;color:#fff}\nsection button:focus{outline:2px solid #0b5cff;outline-offset:2px}\nsection button.secondary{background:#fff;color:#0f172a;border:1px solid #cbd5e1}\n.status{padding:0.5rem 0.75rem;border-radius:6px;background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;margin-bottom:1rem;display:inline-flex;align-items:center;gap:0.5rem}\n.status::before{content:\"\";display:inline-block;width:10px;height:10px;border-radius:50%;background:#10b981}\n.toast{position:fixed;bottom:1rem;right:1rem;background:#0f172a;color:#fff;padding:0.6rem 0.9rem;border-radius:6px;opacity:0;transition:opacity .3s;pointer-events:none}\n.toast.show{opacity:1}\n.appendix table{font-size:0.9rem}\n.appendix th{background:#f1f5f9}\n@media (max-width:800px){\n  .layout{flex-direction:column}\n  .sidebar{width:100%;height:auto;position:static;border-right:none;border-bottom:1px solid #e2e8f0}\n}\n</style>\n</head>\n<body>\n<header>\n<h1>Atlas Operations Manual</h1>\n<div class=\"search\">\n<input type=\"search\" id=\"search\" placeholder=\"Search sections...\" aria-label=\"Search sections\">\n<button id=\"clearSearch\">Clear</button>\n</div>\n<div class=\"status\" id=\"systemStatus\">System nominal</div>\n</header>\n<div class=\"layout\">\n<aside class=\"sidebar\" aria-label=\"Section navigation\">\n<nav>\n<ul id=\"toc\"></ul>\n</nav>\n</aside>\n<main id=\"content\">\n<section id=\"s1\">\n<h2>1. Introduction</h2>\n<p>This manual describes operational procedures for the Atlas platform. It is intended for engineers, operators, and auditors who require precise guidance.</p>\n<p>All numbered sections must be reviewed in order. Deviations require documented approval from the operations lead.</p>\n<dl>\n<dt>Scope</dt><dd>Core platform operations and maintenance</dd>\n<dt導演</dt><dd>Operations Director</dd>\n<dt>Revision</dt><dd>2025-06-01</dd>\n<dt>Classification</dt><dd>Internal Use</dd>\n</dl>\n<table>\n<caption>Revision history</caption>\n<thead><tr><th>Rev</th><th>Date</th><th>Author</th><th>Notes</th><th>Approved</th><th>Pages</th></tr></thead>\n<tbody>\n<tr><td>1.0</td><td>2025-06-01</td><td>A. Smith</td><td>Initial release</td><td>Yes</td><td>400</td></tr>\n<tr><td>1.1</td><td>2025-07-15</td><td>B. Jones</td><td>Clarified safety</td><td>Yes</td><td>405</td></tr>\n<tr><td>1.2</td><td>2025-08-20</td><td>C. Lee</td><td>Updated commands</td><td>Pending</td><td>410</td></tr>\n<tr><td>1.3</td><td>2025-09-10</td><td>D. Patel</td><td>Appendix added</td><td>Pending</td><td>420</td></tr>\n<tr><td>1.4</td><td>2025-10-01</td><td>E. Kim</td><td>Formatting</td><td>Pending</td><td>430</td></tr>\n<tr><td>1.5</td><td>2025-10-30</td><td>F. Garcia</td><td>Review complete</td><td>Pending</td><td>440</td></tr>\n</tbody>\n</table>\n<pre>atlas intro --read --verbose</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s2\">\n<h2>2. Purpose</h2>\n<p>The Atlas platform centralizes telemetry, workflow orchestration, and compliance reporting. This manual ensures consistent execution across sites.</p>\n<p>Readers should verify they are using the correct edition before applying procedures.</p>\n<dl>\n<dt>Objective</dt><dd>Unified operations</dd>\n<dt>Stakeholders</dt><dd>Engineering, Safety, QA</dd>\n<dt>Frequency</dt><dd>Continuous</dd>\n<dt>Metrics</dt><dd>Uptime, error rate, latency</dd>\n</dl>\n<table>\n<caption>Purpose metrics</caption>\n<thead><tr><th>Metric</th><th>Target</th><th>Current</th><th>Owner</th><th>Source</th><th>Alert</th></tr></thead>\n<tbody>\n<tr><td>Uptime</td><td>99.95%</td><td>99.97%</td><td>Ops</td><td>Monitoring</td><td>Email</td></tr>\n<tr><td>Latency</td><td>&lt;200ms</td><td>180ms</td><td>Network</td><td>APM</td><td>Page</td></tr>\n<tr><td>Errors</td><td>&lt;0.1%</td><td>0.08% Proper</td><td>QA</td><td>Logs</td><td>Ticket</td></tr>\n<tr><td>Backlog</td><td>&lt;50</td><td>42</td><td>Product</td><td>Jira</td><td>Slack</td></tr>\n<tr><td>Compliance</td><td>100%</td><td>100%</td><td>Legal</td><td>Audit</td><td>Report</td></tr>\n<tr><td>Training</td><td>Monthly</td><td>Monthly</td><td>HR</td><td>LMS</td><td>None</td></tr>\n</tbody>\n</table>\n<pre>atlas purpose --list-metrics</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s3\">\n<h2>3. Scope</h2>\n<p>This manual covers configuration, deployment, monitoring, incident response, and decommissioning. Out-of-scope items are listed in Appendix C.</p>\n<p>Each subsection defines responsibilities and required artifacts.</p>\n<dl>\n<dt>In scope</dt><dd>All production clusters</dd>\n<dt>Out of scope</dt><dd>Experimental labs</dd>\n<dt>Interface</dt><dd>CLI, API, UI</dd>\n<dt>Change control</dt><dd>RFC process</dd>\n</dl>\n<table>\n<caption>Scope boundaries</caption>\n<thead><tr><th>Area</th><th>Included</th><th>Excluded</th><th>Owner</th><th>Review cadence</th><th>Last review</th></tr></thead>\n<tbody>\n<tr><td>Compute</td><td>Yes</td><td>No</td><td>Infra</td><td>Quarterly</td><td>2025-09-01</td></tr>\n的直接<tr><td>Network</td><td>Yes</_prefix><td>No</td><td>Net</td><td>Monthly</td><td>2025-10-01</td></tr>\n<tr><td>Storage</td><td>Yes</td><td>No</td><td>Data</td><td>Quarterly</td><td>2025-09-15</td></tr>\n<tr><td>Security</td><td>Yes</td><td>No</td><td>SecOps</td><td>Monthly</td><td>2025-10-05</td></tr>\n<tr><td>Compliance</td><td>Yes</td><td>No</td><td>Legal</td><td>Annually</td><td>2025-01-10</td></tr>\n<tr><td>Training</td><td>Yes</td><td>No</td><td>HR</td><td>Monthly</td><td>2025-10-12</td></tr>\n</tbody>\n</table>\n<pre>atlas scope --define</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s4\">\n<h2>4. Definitions</h2>\n<p>Key terms used throughout this manual are defined here to ensure consistent interpretation.</p>\n<p>Terms are sorted alphabetically and cross-referenced where applicable.</p>\n<dl>\n<dt>Cluster</dt><dd>A set of nodes managed as one</dd>\n<dt>Node</dt><dd>Individual host machine</dd>\n<dt>Pod</dt><dd>Smallest deployable unit</dd>\n<dt>Service</dt><dd>Network endpoint abstraction</dd>\n</dl>\n<table>\n<caption>Definitions index</caption>\n<thead><tr><th>Term</th><th>Definition</th><th>Source</th><th>Context</th><th>Example</th><th>Version</th></tr></thead>\n<tbody>\n<tr><td>Cluster</td><td>Group of nodes</td><td>K8s</td><td>Architecture</td><td>prod-01</td><td>v1.28</td></tr>\n<tr><td>Node</td><td>Host machine</td><td>K8s</td><td>Infrastructure</td><td>10.0.0.1</td><td>v1.28</td></tr>\n<tr><td>Pod</td><td>Deployable unit</td><td>K8s</td><td分钟左右Workload</td><td>api-7f9c</td><td>v1.28</td></tr>\n<tr><td>Service</td><td>Network abstraction</td><td>K8s</td><td>Networking</td><td>api-svc</td><td>v1.28</td></tr>\n<tr><td>Namespace</td><td>Virtual cluster</td><td>K8s</td><td>Multi-tenant</td><td>default</td><td>v1.28</td></tr>\n<tr><td>ConfigMap</td><td>Configuration data</td><td>K8s</td><td>Config</td><td>app-config</td><td>v1.28</td></tr>\n</tbody>\n</table>\n<pre>atlas terms --list</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s5\">\n<h2>5. System Overview</h2>\n<p>The Atlas system comprises control plane, data plane, and auxiliary services. Each layer has defined SLAs and redundancy requirements.</p>\n<p>Diagrams are maintained in the engineering wiki and versioned alongside code.</p>\n<抬起头dl>\n<dt>Control plane</dt><dd>Management and scheduling</dd>\n<dt>Data plane</dt><dd>Workload execution</dd>\n<dt>Auxiliary</dt><dd>Monitoring, logging, backup</dd>\n<dt>Redundancy</dt><dd>Multi-zone deployment</dd>\n</dl>\n<table>\n<caption>System components</caption>\n<thead><tr><th>Component</th><th>Role</th><th>Replicas</th><th>Criticality</th><th>Uptime SLA</th><th>Owner</th></tr></thead>\n<tbody>\n<tr><td>API Server</td><td>Entry point</td><td>3</td><td>High</td><td>99.99%</td><td>Platform</td></tr>\n<tr><td>etcd</td><td>State store</td><td>3</td><td>Critical</td><td>99.999%</td><td>Storage</td></tr>\n<tr><td>Scheduler</td><td>Pod placement</td><td>1</td><td>High</td><td>99.9%</td><td>Platform</td></tr>\n<tr><td>Controller</td><td>Reconciliation</td><td>1</td><td>High</td><td>99.9%</td><td>Platform</td></tr>\n<tr><td>Proxy</td><td>Network routing</td><td>Per node</td><td>Medium</td><td>99.9%</td><td>Network</td></tr>\n<tr><td>Ingress</td><td>External access</td><td>2</td><td>High</td><td>99.95%</td><td>Network</td></tr>\n</tbody>\n</table>\n<pre>atlas overview --components</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\nsterdam</section>\n<section id=\"s6\">\n<h2>6. Architecture</h2>\n<p>Architecture follows a layered model with clear separation of concerns. Communication between layers uses authenticated gRPC and REST.</p>\n<p>All services expose health and readiness endpoints on port 8080.</p>\n<dl>\n<dt>Layer</dt><dd>Logical grouping</dd>\n<dt>Boundary</dt><dd>API contract</dd>\n<dt>Protocol</dt><dd>gRPC, HTTPS</dd>\n<dt>Port</dt><dd>8080, 9090</dd>\n</dl>\n<table>\n<caption>Layer inventory</caption>\n<thead><tr><th>Layer</th><th>Services</th><th>Ports</th><th>Auth</th><th>Logging</th><th>Monitoring</th></tr></thead>\n<tbody>\n<tr><td>Edge</td><td>Gateway</td><td>443</td><td>OAuth2</td><td>JSON</td><td>Prometheus</td></tr>\n<tr><td>Service</td><td>Business APIs</td><td>8080</td><td>mTLS</td><td>JSON</td><td>Prometheus</td></tr>\n<tr><td>Data</td><td>Database</td><td>5432</td><td>mTLS</td><td>Slow query</td><td>pgwatch</td></tr>\n<tr><td>Cache</td><td>Redis</td><td>6379</td><td>Password</td><td>Command log</td><td>Redis exporter</td></tr>\n<tr><td>Queue</td><td>Kafka</td><td>9092</td><td>SASL</td><td>Audit</td><td>JMX</td></tr>\n<tr><td>Batch</td><td>Spark</td><td>4040</td><td>Kerberos</td><td>YARN</td><td>Ganglia</td></tr>\n</tbody>\n</table>\n<pre>atlas arch --list-layers</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s7\">\n<h2>7. Deployment Model</h2>\n<p>Deployments use immutable infrastructure with blue-green promotion. Canary releases are mandatory for changes exceeding 5% traffic impact.</p>\n<p>All artifacts are signed and stored in the internal registry.</p>\n<dl>\n<dt>Strategy</dt><dd>Blue-green with canary</dd>\n<dt>Registry</dt><dd>Internal Harbor</dd>\n<dt>Signing</dt><dd>Cosign</dd>\n<dt>Approval</dt><dd>Two engineers</dd>\n</dl>\n<table>\n<caption>Deployment stages</caption>\n<thead><tr><th>Stage</th><th>Duration</th><th>Success criteria</th><th>Rollback trigger</th><th>Owner</th><th>Tooling</th></tr></thead>\n<tbody>\n<tr><td>Build</td><td>10m</td><td>Tests pass</td><td>Fail</td><td>CI</td><td>GitHub Actions</td></tr>\n<tr><td>Staging</td><td>30m</td><td>Smoke pass</td><td>Error rate &gt;1%</td><td>QA</td><td>Argo</td></tr>\n<tr><td>Canary</td><td>15m</td><td>Latency stable</td><td>Latency &gt;250ms</td><td>Ops</td><td>Istio</td></tr>\n<tr><td>Production</td><td>1h</td><td>SLO met</td><td>SLO breach</td><td>Ops</td><td>Argo</td></tr>\n<tr><td>Validation</td><td>24h</td><td>No alerts</td><td>Alert fired</td><td>SRE</td><td>PagerDuty</td></tr>\n<tr><td>Cleanup</td><td>1d</td><td>Artifacts pruned</td><td>N/A</td><td>Infra</td><td>Cron</td></tr>\n</tbody>\n</table>\n<pre>atlas deploy --strategy blue-green</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s8\">\n<h2>8. Configuration Management</h2>\n<p>Configuration is stored in versioned YAML files and applied via GitOps. Secrets are managed in HashiCorp Vault with dynamic leases.</p>\n<p>Changes require PR review and automated validation.</p>\n<dl>\n<dt>Store</dt><dd>Git repository</dd>\n<dt>Secret backend</dt><dd>HashiCorp Vault</dd>\n<dt>Validation</dt><dd>JSON Schema</dd>\n<dt>Audit</dt><dd>Immutable log</dd>\n</dl>\n<table>\n<caption>Configuration items</caption>\n<thead><tr><th>Item</th><th>Format</th><th>Location</th><th>Rotation</th><th>Owner</th><th>Encryption</th></tr></thead>\n<tbody>\n<tr><td>API keys</td><td>YAML</td><td>Vault</td><td>90 days</td><td>Security</td><td>AES-256</td></tr>\n<tr><td>TLS certs</td><td>PEM</td><td>Vault</td><td>30 days</td><td>Security</td><td>RSA-4096</td></tr>\n<tr><td>DB credentials</td><td>YAML</td><td>Vault</td><td>60 days</td><td>DBA</td><td>AES-256</td></tr>\n<tr><td>Feature flags</td><td>JSON</td><td>Config repo</td><td>On change</td><td>Product</td><td>None</td></tr>\n<tr><td>Env vars</td><td>YAML</td><td>Config repo</td><td>On change</td><td>DevOps</td><td>None</td></tr>\n<tr><td>Policies</td><td>Rego</td><td>OPA repo</td><td>Quarterly</td><td>Security</td><td>Signed</td></tr>\n</tbody>\n</table>\n<pre>atlas config --validate --strict</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s9\">\n<h2>9. Access Control</h2>\n<p>Access follows least privilege with role-based permissions. All actions are logged and reviewed monthly.</p>\n<p>Multi-factor authentication is required for privileged operations.</p>\n<dl>\n<dt>Model</dt><dd>RBAC</dd>\n<dt>MFA</dt><dd>TOTP mandatory</dd>\n<dt>Review</dt><dd>Monthly</dd>\n<dt>Audit</dt><dd>SIEM integration</dd>\n</dl>\n<table>\n<caption>Role matrix</caption>\n<thead><tr><th>Role</th><th>Read</th><th>Write</th><th>Delete</th><th>Admin</th><th>MFA</th><th>Review</th></tr></thead>\n<tbody>\n<tr><td>Viewer</td><td>Yes</td><td>No</td><td>No</td><td>No</td><td>No</td><td>Quarterly</td></tr>\n<tr><td>Editor</td><td>Yes</td><td>Yes</td><td>No</td><td>No</td><td>Yes</td><td>Monthly</td></tr>\n<tr><td>Admin</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Monthly</td></tr>\n<tr><td>Auditor</td><td>Yes</td><td>No</td><td>No</td><td>No</td><td>Yes</td><td>Quarterly</td></tr>\n<tr><td>Operator</td><td>Yes</td><td>Yes</td><td>No</td><td>No</td><td>Yes</td><td>Monthly</td></tr>\n<tr><td>Root</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes</td><td>Weekly</td></tr>\n</tbody>\n</table>\n<pre>atlas auth --list-roles</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s10\">\n<h2>10. Incident Response</h2>\n<p>Incidents are classified by severity and handled through defined runbooks. Communication follows a cascading alert policy.</p>\n<p>Postmortems are required for severity 1 and 2 incidents within 48 hours.</p>\n<dl>\n<dt>Severity 1</dt><dd>Total outage</dd>\n<dt>Severity 2</dt><dd>Partial outage</dd>\n<dt>Severity 3</dt><dd>Degraded</dd>\n<dt>Severity 4</dt><dd>Minor</dd>\n</dl>\n<table>\n<caption>Severity matrix</caption>\n<thead><tr><th>Severity</th><th>Impact</th><th>Response time</th><th>Escalation</th><th>Communication</th><th>Postmortem</th></tr></thead>\n<tbody>\n<tr><td>1</td><td>Critical</td><td>15m</td><td>VP Eng</td><td>All hands</td><td>Yes</td></tr>\n<tr><td>2</td><td>High</td><td>30m</td><td>Director</td><td>Team leads</td><td>Yes</td></tr>\n<tr><td>3</td><td>Medium</td><td>2h</td><td>Manager</td><td>Slack</td><td>Optional</td></tr>\n<tr><td>4</td><信件><td>Low</td><td>4h</td><td>Lead</td><td>Ticket</td><td>No</td></tr>\n<tr><td>5</td><td>Info</td><td>24h</td><td>None</td><td>Log</td><td>No</td></tr>\n<tr><td>6</td><td>Planned</td><td>1 week</td><td>PM</td><td>Calendar</td><td>No</td></tr>\n</tbody>\n</table>\n grouping<pre>atlas incident --classify --id 1234</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s11\">\n<h2>11. Monitoring</h2>\n<p>Monitoring uses Prometheus for metrics, Loki for logs, and Grafana for dashboards. Alerts route through Alertmanager to PagerDuty.</p>\n<p>All services emit RED metrics: Rate, Errors, Duration.</p>\n<dl>\n<dt>Metrics</dt><dd>Prometheus</dd>\n<dt>Logs</dt><dd>Loki</dd>\n<dt>Dashboards</dt><dd>Grafana</dd>\n<dt>Alerts</dt><dd>Alertmanager</dd>\n</dl>\n<table>\n<caption>Monitoring stack</caption>\n<thead><tr><th>Component</th><th>Port</th><th>Retention</th><th>Resolution</th><th>Storage</th><th>Access</th></tr></thead>\n<tbody>\n<tr><td>Prometheus</td><td>9090</td><td>15 days</td><td>15s</td><td>Local SSD</td><td>Read-only</td></tr>\n<tr><td>Loki</td><td>3100</td><td>30 days</td><td>1m</td><td>S3</td><td>Query</td></tr>\n<tr><td>Grafana</td><td>3000</td><td>N/A</td><td>N/A</td><td>Config</td><td>UI/API</td></tr>\n<tr><td>Alertmanager</td><td>9093</td><td>5 days</td><td>N/A</td><td>Memory</td><td>UI/API</td></tr>\n<tr><td>Node exporter</td><td>9100</td><td>15 days</td><td>15s</td><td>Prometheus</td><td>Scrape</td></tr>\n<tr><td>cAdvisor</td><td>8080</td><td>15 days</td><td>15s</td><td>Prometheus</td><td>Scrape</td></tr>\n</tbody>\n</table>\n<pre>atlas monitor --check --all</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s12\">\n<h2>12. Logging</h2>\n<p>Logs are structured JSON with mandatory fields: timestamp, service, level, message, trace_id. Centralized collection uses Fluent Bit.</p>\n<p>Log access is audited and restricted by role.</p>\n<dl>\n<dt>Format</dt><dd>JSON</dd>\n<dt>Collector</dt><dd>Fluent Bit</dd>\n<dt>Retention</dt><dd>30 days</dd>\n<dt>Access</dt><td>RBAC</td>\n</dl>\n<table>\n<caption>Log levels</caption>\n<客运专线<thead><tr><th>Level</th><th>Value</th><th>Use</th><th>Volume</th><th>Retention</th><th>Alert</th></tr></thead>\n<tbody>\n<tr><td>error</td><td>3</td><td>Failures</td><td>Low</td><td>90 days</td><td>Yes</td></tr>\n<tr><td>warn</td><td>4</td><td>Potential issues</td><td>Medium</td><td>30 days</td><td>Optional</td></tr>\n<tr><td>info</td><td>6</td><td>General</td><td>High</td><td>15 days</td><td>No</td></tr>\n<tr><td>debug</td><td>7</td><td>Development</td><td>Very high</td><td>7 days</td><td>No</td></tr>\n<tr><td>trace</td><td>7</td><td>Verbose</td><td>Very high</td><td>3 days</td><tdermanent No</td></tr>\n<tr><td>fatal</td><td>2</td><td>Unrecoverable</td><td>Low</td><td>180 days</td><td>Yes</td></tr>\n</tbody>\n</table>\n<pre>atlas logs --tail --service api</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s13\">\n<h2>13. Backup and Recovery</h2>\n<p>Backups run daily with weekly offsite copies. Recovery time objective is 4 hours; recovery point objective is 15 deben minutes.</p>\n<p>Backup integrity is verified weekly using checksums.</p>\n<dl>\n<dt>Frequency</dt><dd>Daily</dd>\n<dt>RTO</dt><dd>4 hours</dd>\n<dt>RPO</dt><dd>15 minutes</dd>\n<dt>Storage</dt><dd>S3 with Glacier</dd>\n</dl>\n<table>\n<caption>Backup schedule</caption>\n<thead><tr><th>Dataset</th><th>Frequency</th><th>Retention</th><th>Encryption</th><th>Verification</th><th>Owner</th></tr></thead>\n<tbody>\n<tr><td>PostgreSQL</td><td>Hourly</td><td>30 days</td><td>AES-256</td><td>Daily</td><td>DBA</td></tr>\n<tr><td>etcd</td><td>Every 6h</td><td>90 days</td><td>AES-256</td><td>Weekly</td><td>Platform</td></tr>\n<tr><td>Object store</td><td>Daily</td><td>1 year</td><td>Server-side</td><td>Weekly</td><td>Storage</td></tr>\n<tr><td>Config repo</td><td>Continuous</td><td>Indefinite</td><td>TLS</td><td>On push</td><td>DevOps</td></tr>\n<tr><td>Secrets</td><td>Real-time</td><td>1 year</td><td>Vault seal</td><td>Monthly</td><td>Security</td></tr>\n<tr><td>Images</td><td>Daily</td><td>6 months</td><td>Signed</td><td>On scan</td><td>Infra</td></tr>\n</tbody>\n</table>\n<pre>atlas backup --verify --all</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s14\">\n<h2>14. Security</h2>\n<p>Security controls include network policies, pod security standards, image scanning, and runtime threat detection.</p>\n<p>Vulnerabilities must be patched within SLA based on severity.</p>\n<dl>\n<dt>Policy engine</dt><dd>OPA Gatekeeper</dd>\n<dt>Scanning</dt><dd>Trivy</dd>\n<dt>Runtime</dt><dd>Falco</dd>\n<dt>SLA</dt><dd>Critical 7 days</dd>\n</dl>\n<table>\n<caption>Vulnerability SLA</caption>\n<thead><tr><th>Severity</th><th>SLA</th><th>Scan freq</th><th>Auto-remediate</th><th>Reporting</th><th>Owner</th></tr></thead>\n<tbody>\n<tr><td>Critical</td><td>7 days</td><td>Daily</td><td>Yes</td><td>Daily</td><td>Security</td></tr>\n<tr><td>High</td><td>30 days</td><td>Weekly</td><td>No</td><.password>Weekly</td><td>Security عام</td></tr>\n<tr><td>Medium</td><td>90 days</td><td>Monthly</td><td>No</td><td>Monthly</td><td>DevOps</td></tr>\n<tr><td>Low</td><td>180 days</td><td>Quarterly</td><td>No</td><td>Quarterly</td><td>DevOps</td></tr>\n<tr><td>Negligible</td><td>365 days</td><td>Annually</td><td>No</td><td>Annually</td><td>DevOps</td></tr>\n<tr><td>Experimental</td><td>Best effort</td><td>On demand</td><td>No</td><td>On demand</td><td>Research</td></tr>\n</tbody>\n</table>\n<pre>atlas security --scan --critical</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s15\">\n<h2>15. Change Management</h2>\n<p>All changes require a Request for Change (RFC) with risk assessment, rollback plan, and approval from the change advisory board.</p>\n<p>Emergency changes follow an expedited process with post-change review.</p>\n<dl>\n<dt>RFC</dt><dd>Required for all changes</dd>\n<dt>CAB</dt><dd>Weekly meeting</dd>\n<dt>Emergency</dt><dd>VP approval</dd>\n<dt>Review</dt><dd>Post-change within 24h</dd>\n</dl>\n<table>\n<caption>Change types</caption>\n<thead><tr><th>Type</th><th>Notice</th><th>Approval</th><th>Testing</th><th>Rollback</th><th>Communication</th></tr></thead>\n<tbody>\n<tr><td>Standard</td><td>5 days</td><td>CAB</td><td>Staging</td><td>Automated</td><td>Email</td></tr>\n<tr><td>Normal</td><td>2 days</td><td>Manager</td><td>Staging</td><td>Automated</td><td>Slack</td></tr>\n<tr><td>Emergency</td><td>1 hour</td><td>VP</td><td>Canary</td><td>Manual</td><td>Phone</td></tr>\n<tr><td>Patch</td><td>24 hours</td><td>Lead</td><td>Smoke</td><td>Automated</td><td>Ticket</td></tr>\n<tr><td>Config</td><td>1 day</td><td>Lead</td><td>Validate</td><td>Automated</td><td>Slack</td></tr>\n<tr><td>Data</td><td>4 hours</td><td>DBA</td><td>Backup verify</td><td>Restore</td><td>Email</td></tr>\n</tbody>\n</table>\n<pre>atlas change --submit --type normal</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s16\">\n<h2>16. Release Process</h2>\n<p>Releases are cut from the main branch after passing all CI gates. Release notes are generated from commit history and reviewed before publication.</p>\n<p>Hotfixes branch from the latest production tag.</p>\n<dl>\n<dt>Branching</dt><dd>GitFlow</dd>\n<dt>Tagging</dt><dd>Semantic version</dd>\n<dt>Notes</dt><dd>Auto-generated</dd>\n<dt>Hotfix</dt><dd>From prod tag</dd>\n</dl>\n<table>\n<caption>Release checklist</caption>\n<thead><tr><th>Step</th><th>Owner</th><th>Tool</th><th>Duration</th><th>Gate</th><th>Artifact</th></tr></thead>\n<tbody>\n<tr><td>Branch</td><td>Dev</td><td>Git</td><td>5m</td><td>CI pass</td><td>Branch</td></tr>\n<tr><td>Build</td><td>CI</td><td>GitHub Actions</td><td>10m</td><td>Tests pass</td><td>Binary</td></tr>\n<tr><td>Sign</td><td>Release</td><td>Cosign</td><td>2m</td><td>Key available</td><td>Signature</td></tr>\n<tr><td>Publish</td><td>Release</td><td>Harbor</td><td>5m</td><td>Scan pass</td><td>Image</td></tr>\n<tr><td>Deploy</td><td>Ops</td><td>Argo</td><td>15m</td><td>Health check</td><td>Deployment</td></tr>\n<tr><td>Verify</td><td>QA</td><td>Automated</td><td>30m</td><td>SLO met</td><td>Report</td></tr>\n</tbody>\n</table>\n<pre>atlas release --cut --version 1.2.3</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s17\">\n<h2>17. Testing Strategy</h2>\n<p>Testing is layered: unit, integration, contract, and end-to-end. Coverage thresholds are enforced in CI.</p>\n<p>Performance tests run nightly on production-like environments.</p>\n<dl>\n<dt>Unit</dt><dd>Jest</dd>\n<dt>Integration</dt><dd>Testcontainers</dd>\n<dt>Contract</dt><dd>Pact</dd>\n<dt>E2E</dt><td>Cypress</td>\n</dl>\n<table>\n<caption>Test coverage</caption>\n<thead><tr><th>Type</th><th>Tool</th><th>Min coverage</th><th>Runtime</th><th>Environment</th><th>Frequency</th></tr></thead>\n<tbody>\n<tr><td>Unit</td><td>Jest</td><td>90%</td><td>&lt;5m</td><td>Local</td><td>On commit</td></tr>\n<tr><td>Integration</td><td>Testcontainers</td><td>80%</td><td>&lt;30m</td><td>CI</td><td>On PR</td></tr>\n<tr><td>Contract</td><td>Pact</td><td>85%</td><td>&lt;10m</td><td>CI</td><td>On PR</td></tr>\n<tr><td>E2E</td><td>Cypress</td><td>N/A</td><td>&lt;1h</td><td>Staging</td><td>Nightly</td></tr>\n<tr><td>Performance</td><td>k6</td><td>SLO</td><td>&lt;2h</td><td>Staging</td><td>Nightly</td></tr>\n<tr><td>Security</td><td>OWASP ZAP</td><td>Pass</td><td>&lt;1h</td><td>CI</td><td>Nightly</td></tr>\n</tbody>\n</table>\n<pre>atlas test --coverage --fail-under 90</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s18\">\n<h2>18. Quality Assurance</h2>\n<p>QA owns test planning, defect triage, and release acceptance. Defects are tracked in Jira with severity and priority fields.</p>\n<p>Release acceptance requires passing regression suite on staging.</p>\n<dl>\n<dt>Process</dt><dd>Triage within 24h</dd>\n<dt>Tool</dt><dd>Jira</dd>\n<dt>Regression</dt><dd>Automated</dd>\n<dt>Sign-off</dt><dd>QA lead</dd>\n</dl>\n<table>\n<caption>Defect severity</caption>\n<thead><tr><th>Severity</th><th>Description</th><th>Response</th><th>Target fix</th><th>Escalation</th><th>Example</th></tr></thead>\n<tbody>\n<tr><td>Blocker</td><td>No workaround</td><td>Immediate</td><td>24h</td><td>VP Eng</td><td>Data loss</td></tr>\n<tr><td>Critical</td><td>Major feature broken</td><td>4h</td><td>3 days</td><td>Director</td><td>Login fails</td></tr>\n<tr><td>Major</td><td>Feature impaired</td><td>1 day</td><td>2 weeks</td><td>Manager</td><td>Slow search</td></tr>\n<tr><td>Minor</td><td>Annoying</td><td>3 days</td><td>1 month</td><td>Lead</td><td>UI glitch</td></tr>\n<tr><td>Trivial</td><td>Cosmetic</td><td>1 week</td><td>Next release</td><td>None</td><td>Typo</td></tr>\n<tr><td>Enhancement</td><td>New feature</td><td>Backlog</td><td>Roadmap</td><td>PM</td><td>Add filter</td></tr>\n</tbody>\n</table>\n<pre>atlas qa --defects --severity critical</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s19\">\n<h2>19. Performance</h2>\n<p>Performance budgets are defined per service. Exceeding budgets triggers an automatic ticket and investigation.</p>\n<p>Load tests simulate peak traffic plus 20% headroom.</p>\n<dl>\n<dt>Budget</dt><dd>P95 &lt;200ms</dd>\n<dt>Load test</dt><dd>k6</dd>\n<dt>Profiling</dt><dd>pprof</dd>\n<dt>Alert</dt><dd>PagerDuty</dd>\n</dl>\n<table>\n<caption>Performance budgets</caption>\n<thead><tr><th>Service</th><th>P50</th><th>P95</th><th>P99</th><th>Throughput</th><th>Error budget</th></tr></thead>\n<tbody>\n<tr><td>API</td><td>50ms</td><td>200ms</td><td>500ms</td><td>10k RPS</td><td>0.1%</td></tr>\n<tr><td>Web</td><td>100ms</td><td>300ms</td><td>1s</td><td>5k RPS</td><td>0.2%</td></tr>\n<tr><td>Mobile</td><td>150ms</td><td>400ms</td><td>2s</td><td>2k RPS</td><td>0.5%</td></tr>\n<tr><td>Batch</td><td>1s</td><td>5s</td><td>30s</td><td>100 jobs/min</td><td>1%</td></tr>\n<tr><td>Realtime</td><td>20ms</td><td>100ms</td><td>200ms</td><td>50k msg/s</td><td>0.05%</td></tr>\n<tr><td>Admin</td><td>200ms</td><td>600ms</td><td>3s</td><td>500 RPS</td><td>1%</td></tr>\n</tbody>\n</table>\n<pre>atlas perf --load --duration 10m</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s20\">\n<h2>20. Capacity Planning</h2>\n<p>Capacity is reviewed quarterly. Forecasting uses linear regression on usage metrics with a 6-month horizon.</p>\n<p>Scaling policies define thresholds for horizontal and vertical scaling.</p>\n<dl>\n<dt>Review cadence</dt><dd>Quarterly</dd>\n<dt>Forecast</dt><dd>6 months</dd>\n<dt>Scaling</dt><dd>HPA/VPA</dd>\n<dt>Buffer</dt><dd>20%</dd>\n</dl>\n<table>\n<caption>Capacity forecast</caption>\n<thead><tr><th>Resource</th><th>Current</th><th>Forecast 6m</th><th>Forecast 12m</th><th>Action threshold</th><th>Owner</th></tr></thead>\n<tbody>\n<tr><td>CPU</td><td>60%</td><td>75%</td><td>90%</td><td>85%</td><td>Infra</td></tr>\n<tr><td>Memory</td><td>70%</td><td>80%</td><td>95%</td><td>90%</td><td>Infra</td></tr>\n<tr><td>Disk</td><td>55%</td><td>65%</td><td>80%</td><td>80%</td><td>Storage</td></tr>\n<tr><td>Network</td><td>40%</td><td>50%</td><td>70%</td><td>70%</td><td>Network</td></tr>\n<tr><td>GPU</td><td>30%</td><td>50%</td><td>80%</td><td>75%</td><td>ML</td></tr>\n<tr><td>Connections</td><td>45%</td><td>60%</td><td>75%</td><td>80%</td><td>Network</td></tr>\n</tbody>\n</table>\n<pre>atlas capacity --forecast --months 6</pre>\n<div class=\"actions\">\n<button data-action=\"ack\">Acknowledge</button>\n<button class=\"secondary\" data-action=\"print\">Print Section</button>\n</div>\n</section>\n<section id=\"s21\">\n<h2>21. Cost Management</h2>\n<p>Costs are tracked per service and per team. Budget alerts trigger at 80% and 100% of allocation.</p>\n<p>FinOps reviews occur monthly to optimize spend.</p>\n<dl>\n<dt>Tool</dt><dd>OpenCost</dd>\n<dt>Alert</dt><dd>80%, 100%</dd>\n<dt>Review</dt><dd>Monthly</dd>\n<dt>Optimization</dt><dd>Rightsizing</dd>\n</dl>\n<table>\n<caption>Cost allocation</caption>\n<thead><tr><th>Team</th><th>Budget</th><th>Spend MTD</th><th>Forecast</th><th>Variance</th><th>Action</th></tr></thead>\n<tbody>\n<tr><td>Platform</td><td>$50k</td><td>$48k</td><td>$52k</td><td>+4%</td><td>Review</td></tr>\n<tr><td>Product</td><td>$30k</td><td>$28k</td><td>$31k</td><td>+3%</td><td>Monitor</td></tr>\n<tr><td>Data</td><td>$40k</td><td>$45k</td><td>$55k</td><td>+15%</td><td>Alert</td></tr>\n<tr><td>ML</td><td>$20k</td><td>$18k</td><td>$22k</td><td>+10%</td><td>Review</td></tr>\n<tr><td>Security</td><td>$10k</td><","tokens":[43274,15096,1281,267,3816,51704,1018,85786,44106,1281,33778,15,26,3816,85786,2329,1281,69406,4,3445,1281,12356,70654,27239,14,6069,16057,31,19,3816,104101,32,4690,9646,25257,30374,1718,10212,1018,94344,1018,12,93,7353,116505,28,41567,37057,29,59033,28,18,29,53916,28,18,1778,6541,93,88352,11543,17129,59073,74690,1778,7193,93,18742,36941,28,27824,59653,14162,42123,68322,14,33373,5670,22095,14,35936,7544,14,14505,127949,37361,5550,26909,634,80985,29,1836,47904,28,19,16,24,29,10323,27462,19,67,19,67,19,67,29,23734,27462,72,23,72,25,11045,29,9887,28,28695,29,28695,47012,28,19456,29,1930,47904,28,1457,62331,1778,67,93,10323,27462,18,68,23,69,617,29,2067,81141,33405,791,1778,67,28,70133,28861,75382,93,2067,81141,28,47706,1778,16771,93,6988,28,318,40196,29,16126,28,18,29,92,57249,28,1457,29,23734,27462,18,72,10925,67,29,10323,27462,52396,29,53916,28,18,16,2402,3812,223,19,3812,29,9887,28,28695,29,60339,41779,28,18631,29,5134,2196,24126,28,20229,58650,29,71553,28,19,3812,29,28695,97358,28,49660,1778,16771,310,19,93,18742,17809,28,19,16,1069,3812,29,18742,29364,28,8996,29,19205,17243,8721,28,18,16,3425,381,1778,16771,1204,14346,93,9887,28,28695,29,60339,41779,28,18631,29,71553,28,18,16,23,3812,1778,16771,4346,61,4611,1281,14346,13747,93,53916,28,18,16,1883,3812,223,18,16,24,3812,29,41567,41913,28,22,5438,29,41567,28,19,5438,7527,1823,19669,10081,29,23734,27462,19,71,17928,68,29,10323,27462,72,19,72,23,72,27,29,1930,27239,28,9663,5438,1778,16771,10549,93,23734,27462,18,68,23,69,617,29,10323,27462,52396,29,41567,33405,791,29,53916,28,18,16,1883,3812,223,18,16,25,3812,29,41567,41913,28,22,5438,29,120067,28,66906,29,18742,29364,28,6391,1778,16771,10549,28,7013