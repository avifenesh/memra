hadow:var(--shadow)}\n.card h3{margin:0 0 .25rem;font-size:1rem}\n.card .value{font-size:1.5rem;font-weight:700}\n.card .meta{color:var(--muted);font-size:.85rem}\nsection{background:var(--surface);border:1px solid var(--border);border-radius:.5rem;padding:1rem;margin-bottom:1rem;box-shadow:var(--shadow)}\nsection h2{margin:0 0 .5rem;font-size:1.15rem}\nsection p{margin:.5rem 0}\nsection dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.5rem;margin:.75rem 0}\nsection dt{font-weight:600}\nsection dd{margin:0}\nsection table{width:100%;border-collapse:collapse;margin:.75rem 0}\nsection th,section td{border:1px solid var(--border);padding:.5rem;text-align:left;font-size:.95rem}\nsection th{background:#eef2f7}\nsection pre{background:#0f1720;color:#e6edf3;padding:.75rem;border-radius:.375rem;overflow:auto;font-size:.9rem}\nsection .actions{display:flex;gap:.5rem;margin-top:.5rem}\nsection button{padding:.45rem .7rem;border:1px solid var(--border);background:var(--surface);border-radius:.375rem;cursor:pointer}\nsection button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}\nsection button.danger{background:var(--danger);color:#fff;border-color:var(--danger)}\n.toast{position:fixed;bottom:1rem;right:1rem;background:#111827;color:#fff;padding:.75rem 1rem;border-radius:.375rem;box-shadow:var(--shadow);opacity:0;transition:opacity .2s}\n.toast.show{opacity:1}\n@media(max-width:800px){.layout{grid-template-columns:1fr}aside{display:none}header .search{display:none}}\n</style>\n</head>\n<body>\n<header>\n<h1>Atlas Operations Manual</h1>\n<div class=\"search\">\n<input id=\"search\" type=\"search\" placeholder=\"Search sections...\" aria-label=\"Search sections\">\n<button id=\"clearSearch\">Clear</button>\n</div>\n</header>\n<div class=\"layout\">\n<aside>\n<h2>Contents</h2>\n<nav id=\"toc\"></nav>\n</aside>\n<main>\n<div class=\"status\" id=\"status\">\n<div class=\"card\"><h3>Total Sections</h3><div class=\"value\" id=\"tot