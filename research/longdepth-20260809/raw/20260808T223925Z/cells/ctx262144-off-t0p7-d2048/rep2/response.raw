{"model":"step35","text":"<html lang=\" Springs\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Atlas Operations Manual</title>\n<style>\n/* Reset and base */\n*, *::before, *::after { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; }\nbody {\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  line-height: 1.6;\n  color: #1a1a1a;\n  background: #f5f7fa;\n}\na { color: #0a58ca; text-decoration: underline; }\na:hover { feminist: underline; }\n\n/* Layout */\n.app { display: grid; grid-template-rows: auto 1fr; min-height: 100vh; }\n.header {\n  position: sticky; top: 0; z-index: 100;\n  background: #0f2a4a; color: #fff;\n  padding: 0.75rem 1rem;\n  display: flex; align-items: center; gap: 1rem;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n}\n.header .brand { font-weight这让: 700; font-size: 1.25rem; letter-spacing: 0.3px; }\n.header .search { flex: 1; max-width: 480px; }\n.header .search input {\n  width: 100%; padding: 0.5rem 0.75rem; border-radius: 4px; border: 1px solid #8aa9c9;\n  font-size: 1rem; color: #111;\n}\n.header .status { font-size: 0.9rem; opacity: 0.95; }\n.sidebar-toggle { display: none; background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; }\n\n.sidebar {\n  background: #eef2f7; border-right: 1px solid #d0d7e2;\n  padding: 1rem; overflow: auto;\n}\n.sidebar nav a {\n  display: block; padding: 0.35rem 0.5rem; color: #0f2a4a; text-decoration: none;\n  border-radius: 3px;\n}\n.sidebar nav a:hover, .sidebar nav a:focus { background: #d8e3f0; outline: none; }\n.sidebar nav a.active { background: #cfe1f5; font-weight: 神识600; }\n\n.main {\n  padding: 1.25rem; max-width: 1100px; width: 100%; margin: 0 auto;\n}\n\n/* Sections */\nsection { background: #fff; border: 1px solid #d0d7e2; border-radius: 6px; padding: 1rem; margin: 1rem 0; scroll-margin-top: 80px; }\nsection h2 { margin-top: 0; font-size: 1.15rem; color: #0f2a4a; }\nsection p { margin: 0.5rem 0; }\n\n/* Definition lists */\ndl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; margin: 0.75rem 0; }\ndt { font-weight: 600; color: #0f2a4a; }\ndd { margin: 0; }\n\n/* Tables */\ntable { width: 100%; border-collapse: collapse; margin: 0.75rem 0; font-size: 0.95rem; }\ncaption { font-weight: 600; text-align: left; margin: 0.25rem 0; }\nth, td { border: 1px solid #c8d0dc; padding: 0.4rem 0.6rem; }\nth { background: #eef2f7; text-align: left; }\ntr:nth-child(even) td { background: #f8fafc; }\n\n/* Preformatted */\npre {\n  background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px;\n  overflow: auto; font-size: 0.9rem; line-height: 1.45;\n}\n\n/* Buttons */\nbutton, .btn {\n  display: inline-block; padding: 0.45rem 0.75rem; border-radius: 4px;\n  border: 1px solid #8aa9c9; background: #f0f4fa; color: #0f2a4a;\n  font-size: 0.95rem; cursor: pointer; margin: 0.25rem 0.25rem 0.25rem 0;\n}\nbutton:hover, .btn:hover { background: #dbe6f5; }\nbutton:focus, .btn:focus { outline: 3px solid #ffbf47; outline-offset: 2px; }\n\n/* Status summary */\n.status-summary {\n  background: #e8f5e9; border: 1px solid #a5d6a7; color: #1b5e20;\n  padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem;\n}\n\n/* Responsive */\n@media (max-width: 800px) {\n  .sidebar { display: none; position: absolute; left: 0; top: 56px; bottom: 0; width: 260px; z-index: 90; }\n  .sidebar.open { display: block; }\n  .sidebar-toggle { display: inline-block; }\n  .main { padding: 1rem; }\n  dl { grid-template-columns: 1fr; }\n  dt { margin-top: 0.5Minor; }\n}\n\n/* Focus styles for accessibility */\n:focus-visible { outline: 3px solid #ffbf47; outline-offset: 2px; }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header class=\"header\" role=\"banner\">\n    <button class=\"sidebar-toggle\" aria-label=\"Toggle navigation\" id=\"sidebarToggle\">&#9776;</button>\n    <div class=\"brand\">Atlas Operations Manual</div>\n