  "text": "<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Atlas Operations Manual</title>\n<style>\n:root{--bg:#f4f6f8;--surface:#ffffff;--text:#1a1a1a;--muted:#5a6573;--accent:#0b5cff;--accent2:#00a86b;--danger:#d93025;--warn:#f9ab00;--border:#d2d7de;--shadow:0 2px 8px rgba(0,0,0,0.08)}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--text);line-height:1.55}\nheader{position:sticky;top:0;z-index:100;background:var(--surface);border-bottom:1px solid var(--border);padding:0.75rem 1rem;display:flex;align-items:center;gap:1rem;box-shadow:var(--shadow)}\nheader h1{font-size:1.25rem;margin:0}\nheader .search{margin-left:auto;display:flex;gap:.5rem;align-items:center}\nheader input{padding:.5rem .75rem;border:1px solid var(--border);border-radius:.375rem;min-width:220px}\nheader button{padding:.5rem .75rem;border:1px solid var(--border);background:var(--surface);border-radius:.375rem;cursor:pointer}\nheader button:focus-visible,aside button:focus-visible,section button:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}\n.layout{display:grid;grid-template-columns:260px 1fr;min-height:calc(100vh - 56px)}\naside{background:var(--surface);border-right:1px solid var(--border);padding:1rem;position:sticky;top:56px;height:calc(100vh - 56px);overflow:auto}\naside h2{font-size:1rem;margin:0 0 .5rem}\naside nav{display:flex;flex-direction:column;gap:.25rem}\naside a{color:var(--text);text-decoration:none;padding:.35rem .5rem;border-radius:.25rem;font-size:.95rem}\naside a:hover{background:#eef2f7}\nmain{padding:1.25rem}\n.status{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:1.25rem}\n.card{background:var(--surface);border:1px solid var(--border);border-radius:.5rem;padding:1rem;box-shadow:var(--shadow)}\n.card h3{margin:0 0 .25rem;font-size:1rem}\n.card .value{font-size:1.5rem;font-weight:700}\n.card .meta{color:var(--muted);font-size:.85rem}\nsection{background:var(--surface);border:1px solid var(--border);border-radius:.5rem;padding:1rem;margin-bottom:1rem;box-shadow:var(--shadow)}\nsection h2{margin:0 0 .5rem;font-size:1.15rem}\nsection p{margin:.5rem 0}\nsection dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.5rem;margin:.75rem 0}\nsection dt{font-weight:600}\nsection dd{margin:0}\nsection table{width:100%;border-collapse:collapse;margin:.75rem 0}\nsection th,section td{border:1px solid var(--border);padding:.5rem;text-align:left;font-size:.95rem}\nsection th{background:#eef2f7}\nsection pre{background:#0f1720;color:#e6edf3;padding:.75rem;border-radius:.375rem;overflow:auto;font-size:.9rem}\nsection .actions{display:flex;gap:.5rem;margin-top:.5rem}\nsection button{padding:.45rem .7rem;border:1px solid var(--border);background:var(--surface);border-radius:.375rem;cursor:pointer}\nsection button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}\nsection button.danger{background:var(--danger);color:#fff;border-color:var(--danger)}\n.toast{position:fixed;bottom:1rem;right:1rem;background:#111827;color:#fff;padding:.75rem 1rem;border-radius:.375rem;box-shadow:var(--shadow);opacity:0;transition:opacity .2s}\n.toast.show{opacity:1}\n@media(max-width:800px){.layout{grid-template-columns:1fr}aside{display:none}header .search{display:none}}\n</style>\n</head>\n<body>\n<header>\n<h1>Atlas Operations Manual</h1>\n<div class=\"search\">\n<input id=\"search\" type=\"search\" placeholder=\"Search sections...\" aria-label=\"Search sections\">\n<button id=\"clearSearch\">Clear</button>\n</div>\n</header>\n<div class=\"layout\">\n<aside>\n<h2>Contents</h2>\n<nav id=\"toc\"></nav>\n</aside>\n<main>\n<div class=\"status\" id=\"status\">\n<div class=\"card\"><h3>Total Sections</h3><div class=\"value\" id=\"tot