{"model":"step35","text":"<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Atlas Operations Manual</title>\n<style>\n:root {\n  --bg: #f4f6f8;\n  --surface: #ffffff;\n  --text: #111111;\n  --muted: #555555;\n  --accent: #0b4f7c;\n  --accent2: #d45f00;\n  --border: #cccccc;\n  --focus: #ffd700;\n}\n* { box-sizing: border-box; }\nhtml, body { margin: 0; padding: 0; }\nbody {\n  font-family: system-ui, Segoe UI, Arial, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  line-height: 1.6;\n}\nheader {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  background: var(--surface);\n  border-bottom: 2px solid var(--accent);\n  padding: 0.5rem 1rem;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  align-items: center;\n  justify-content: space-between;\n}\nheader h1 {\n  margin: 0;\n  font-size: 1.25rem;\n  color: var(--accent);\n}\nheader .search {\n  display: flex;\n  gap: 0.25rem;\n}\nheader input {\n  padding: 0.4rem 0.6rem;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  font-size: 0.95rem;\n}\nheader button {\n  padding: 0.4rem 0.7rem;\n  background: var(--accent);\n  color: #fff;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n}\nheader button:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n.layout {\n  display: flex;\n}\naside {\n  width: 220px;\n  background: var(--surface);\n  border-right: 1px solid var(--border);\n  padding: 1rem;\n  position: sticky;\n  top: 3.4rem;\n  align-self: flex-start;\n  max-height: calc(100vh - 3.4rem);\n  overflow: auto;\n}\naside nav ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\naside nav li {\n  margin: 0.25rem 0;\n}\naside nav a {\n  color: var(--accent);\n  text-decoration: none;\n  font-size: 0.9rem;\n}\naside nav a:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\nmain {\n  flex: 1;\n  padding: 1rem;\n  max-width: 1100px;\n}\n.status {\n  background: #e6f4ea;\n  border: 1px solid #b7e1c8;\n  padding: 0.75rem 1rem;\n  margin-bottom: 1rem;\n  border-radius: 6px;\n  display: flex;\n  gap: 1rem;\n  flex-wrap: wrap;\n  align-items: center;\n}\n.status span { font-weight: bold; color: var(--accent); }\n.status button {\n  background: var(--accent2);\n  color: #fff;\n  border: none;\n  padding: 0.4rem 0.7rem;\n  border-radius: 4px;\n  cursor: pointer;\n}\n.status button:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\nsection {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 1rem;\n  margin: 1rem 0;\n}\nsection h2 {\n  margin-top: 0;\n  color: var(--accent);\n  font-size: 1.2rem;\n}\nsection p {\n  margin: 0.5rem 0;\n}\nsection dl {\n  display: grid;\n  grid-template-columns: max-content 1fr;\n  gap: 0.25rem 1rem;\n  background: #fafafa;\n  padding: 0.75rem;\n  border-radius: 4px;\n  margin: 0.5rem 0;\n}\nsection dt {\n  font-weight: bold;\n  color: var(--muted);\n}\nsection dd {\n  margin: 0;\n}\nsection table {\n  width: 100%;\n  border-collapse: collapse;\n  margin: 0.5rem 0;\n}\nsection th, section td {\n  border: 1px solid var(--border);\n  padding: 0.35rem 0.5rem;\n  text-align: left;\n  font-size: 0.9rem;\n}\nsection th {\n  background: #eef2f5;\n}\nsection pre {\n  background: #1e1e1e;\n  color: #dcdcdc;\n  padding: 0.75rem;\n  overflow: auto;\n  border-radius: 4px;\n  font-size: 0.85rem;\n}\nsection .actions {\n  display: flex;\n  gap: 0.5rem;\n  margin-top: 0.5rem;\n  flex-wrap: wrap;\n}\nsection .actions button {\n  background: var(--accent);\n  color: #fff;\n  border: none;\n  padding: 0.4rem 0.7rem;\n  border-radius: 4px;\n  cursor: pointer;\n}\nsection .actions button.secondary {\n  background: #6c757d;\n}\nsection .actions button:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n.results {\n  margin-top: 0.5rem;\n  padding: 0.5rem;\n  border: 1px dashed var(--border);\n  border-radius: 4px;\n  min-height: 1.5rem;\n  font-size: 0.9rem;\n}\n@media (max-width: 800px) {\n  aside { display: none; }\n  .layout { flex-direction: column; }\n}\n</style>\n</head>\n<body>\n<header>\n  <h1>Atlas Operations Manual</h1>\n  <div class=\"search\">\n    <input type=\"search\" id=\"searchInput\" placeholder=\"Search sections...\">\n    <button id=\"searchBtn\">Search</button>\n    <button id=\"clearBtn\">Clear</button>\n  </div>\n</header>\n<div class=\"layout\">\n  <aside>\n    <nav>\n      <ul>\n        <li><a href=\"#s1\">Section 1</a></li>\n        <li><a href=\"#s2\">Section 2</a></li>\n        <li><a href=\"#s3\">Section 3</a></li>\n        <li><a href=\"#s4\">Section 4</a></li>\n        <li><a href=\"#s5\">Section 5</a></li>\n        <li><a href=\"#s6\">Section 6</a></li>\n        <li><a href=\"#s7\">Section 7</a></li>\n        <li><a href=\"#s8\">Section 8</a></li>\n        <li><a href=\"#s9\">Section 9</a></li>\n        <li><a href=\"#s10\">Section 10</a></li>\n      </ul>\n    </nav>\n  </aside>\n  <main>\n    <div class=\"status\" id=\"statusBar\">\n      <div>System Status: <span id=\"sysStatus\">Operational</span></div>\n      <div>Active Sessions: <span id=\"sessionCount\">0</span></div>\n      <button id=\"refreshStatus\">Refresh</button>\n    </div>\n    <div class=\"results\" id=\"results\" aria-live=\"polite\"></div>","tokens":[43274,15096,1281,267,3816,51704,1018,85786,44106,1281,33778,15,26,3816,85786,2329,1281,69406,4,3445,1281,12356,70654,27239,14,6069,16057,31,19,3816,104101,32,4690,9646,25257,30374,1718,10212,1018,94344,1018,28,9056,875,223,3820,40723,28,1823,72,22,72,24,72,26,510,223,3820,94506,28,1823,95761,510,223,3820,2067,28,1823,5822,5822,510,223,3820,79,4679,28,1823,20295,20295,510,223,3820,439,1591,28,1823,18,68,22,72,25,69,510,223,3820,439,1591,20,28,1823,70,1883,72,504,510,223,3820,41567,28,1823,85284,692,510,223,3820,70133,28,1823,617,70,8996,510,1778,12,680,6485,116505,28,9491,37057,29,1554,6541,14,3197,680,