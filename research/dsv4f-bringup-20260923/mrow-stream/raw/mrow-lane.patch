+/// LANE-ONLY A/B read (never merged): 0 = verify rows on sktail, 1 = shipped dispatch,
+/// 2 = the multi-row visitor also takes the one-token step.
+pub fn dsv4_moe_mrow_lane() -> u8 {
+    static V: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *V.get_or_init(|| match std::env::var("MEMRA_DSV4_MOE_MROW_STREAM").as_deref() {
+        Ok("0") => 0,
+        Ok("2") => 2,
+        _ => 1,
+    })
+}
