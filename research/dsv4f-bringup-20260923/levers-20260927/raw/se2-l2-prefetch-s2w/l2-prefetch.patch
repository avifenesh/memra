+// The block's weight rows into L2 before the PDL wait (memra #710). Weights never depend on the
+// predecessor, so a block that becomes resident while a latency-bound predecessor runs starts
+// its stream from L2. A prefetch moves no value, so no output bit can.
+__device__ __forceinline__ void dsv4_l2_prefetch_bytes(const void* base, long bytes) {
+    const char* p = (const char*)base;
+    for (long o = (long)threadIdx.x * 128; o < bytes; o += (long)blockDim.x * 128)
+        asm volatile("prefetch.global.L2 [%0];" ::"l"(p + o));
+}
