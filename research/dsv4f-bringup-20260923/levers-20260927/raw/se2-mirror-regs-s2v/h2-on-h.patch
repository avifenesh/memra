+// x / d where d may be a normal power of two with a normal reciprocal: x * (1 / d) is then the
+// same correctly rounded value, so the multiply keeps the division's bits. Any other divisor
+// divides.
+__device__ __forceinline__ bool dsv4_normal_pow2(float d) {
+    const unsigned b = __float_as_uint(d), e = (b >> 23) & 0xFFu;
+    return (b & 0x807FFFFFu) == 0 && e >= 1 && e <= 253;
+}
+
+__device__ __forceinline__ float dsv4_div_p2(float x, float d, float inv, bool p2) {
+    return p2 ? x * inv : x / d;
+}
+
+// Group g's scale into s_scale[g]: the act_quant group amax, floored, over 448, rounded up to a
+// power of two.
+__device__ __forceinline__ void dsv4_moe_fused_mirror_amax(const float4 v, float* s_scale, int g,
+                                                           int lane) {
+    float a = 0.0f;
+    a = fmaxf(a, fabsf(v.x));
+    a = fmaxf(a, fabsf(v.y));
+    a = fmaxf(a, fabsf(v.z));
+    a = fmaxf(a, fabsf(v.w));
+    float amax = dsv4_warp_max(a);
+    amax = fmaxf(amax, 1e-4f);
+    const float inv = (float)(1.0 / 448.0);
+    if (lane == 0) s_scale[g] = dsv4_pow2_ceil(amax * inv);
+}
+
+// Group g's four values of this lane into the swizzled half staging; returns the lossy flag.
+__device__ __forceinline__ bool dsv4_moe_fused_mirror_pack(const float4 v, const float* s_scale,
+                                                           float rs, float inv_rs, bool rs_p2,
+                                                           uint32_t* As, int g, int lane) {
+    const float s = s_scale[g];
+    const bool s_p2 = dsv4_normal_pow2(s);
+    const float inv_s = s_p2 ? 1.0f / s : 0.0f;
+    const float xv[4] = {v.x, v.y, v.z, v.w};
+    uint32_t hb[4];
+    bool bad = false;
+#pragma unroll
+    for (int j = 0; j < 4; j++) {
+        float q = fminf(fmaxf(dsv4_div_p2(xv[j], s, inv_s, s_p2), -448.0f), 448.0f);
+        uint8_t c = (uint8_t)__nv_cvt_float_to_fp8(q, __NV_SATFINITE, __NV_E4M3);
+        if ((c & 0x7F) == 0) c = 0;
+        float val = dsv4_e4m3(c) * s;
+        __half h = __float2half_rn(dsv4_div_p2(val, rs, inv_rs, rs_p2));
+        float back = __half2float(h) * rs;
+        if ((c & 127) == 127 || !isfinite(val) || __float_as_uint(back) != __float_as_uint(val))
+            bad = true;
+        hb[j] = __half_as_ushort(h);
+    }
+    const int w0 = (g * 128 + lane * 4) / 2;
+    As[dsv4_m1_swz(w0)] = hb[0] | (hb[1] << 16);
+    As[dsv4_m1_swz(w0 + 1)] = hb[2] | (hb[3] << 16);
+    return bad;
+}
