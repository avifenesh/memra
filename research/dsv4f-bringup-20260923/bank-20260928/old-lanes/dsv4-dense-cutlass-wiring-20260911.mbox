From ecf319585e6b97e63111d8e7f19a083ed2c4ba12 Mon Sep 17 00:00:00 2001
From: memra-lane <lane@localhost>
Date: Fri, 11 Sep 2026 18:33:56 +0300
Subject: [PATCH 9/9] dsv4 dense: the A/B cell refuses unless the drafter is
 armed, because the first pair of runs died in the load and reported rc=0

The served process this cell exists to reproduce runs with the drafter RESIDENT
and the prime it times is the drafter's own chunked prime. Run without
MEMRA_DSV4_DRAFTER=dspark the binary loads for 100 seconds and then panics
inside dspark_alloc_state ("MEMRA_DSV4_DRAFTER=dspark not loaded"). Both arms of
the first attempt died that way, at both widths, and the cell script's per-width
`continue` turned four dead runs into a controller exit of 0, so the pair of
receipts looked like cells that had run.

So the binary states the condition it needs before it spends the load: unset or
wrong, it prints AB_FAIL with the value it saw and exits 1. The cell script
treats a failed width as fatal for the same reason.

Signed-off-by: memra-lane <lane@localhost>
---
 crates/memra-engine/src/bin/dsv4_dense_arm_ab.rs | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/crates/memra-engine/src/bin/dsv4_dense_arm_ab.rs b/crates/memra-engine/src/bin/dsv4_dense_arm_ab.rs
index 264d9b036b..bb203c62ce 100644
--- a/crates/memra-engine/src/bin/dsv4_dense_arm_ab.rs
+++ b/crates/memra-engine/src/bin/dsv4_dense_arm_ab.rs
@@ -68,6 +68,22 @@ fn main() {
         Some(armed) => println!("PRESENT armed_at_start={armed}"),
     }
 
+    // The served process runs with the drafter RESIDENT (`[dsv4-serve] ... drafter
+    // RESIDENT (spec route armed)`), and the prime this cell times is the drafter's
+    // own chunked prime. Without the arm the drafter is not loaded and the run dies
+    // 100 seconds into the load, inside `dspark_alloc_state`, with a panic that the
+    // first attempt at this cell mistook for a cell that had run. Refuse up front,
+    // and name the condition being matched.
+    let drafter = std::env::var("MEMRA_DSV4_DRAFTER").unwrap_or_default();
+    if drafter != "dspark" {
+        println!(
+            "AB_FAIL MEMRA_DSV4_DRAFTER={drafter:?}: this cell measures the SERVED shape, \
+             which loads the drafter (spec route armed), so it must be set to dspark"
+        );
+        std::process::exit(1);
+    }
+    println!("DRAFTER dspark (served shape)");
