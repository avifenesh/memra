 fn argmax(row: &[f32]) -> u32 {
     assert!(!row.is_empty() && row.iter().all(|v| v.is_finite()));
@@ -203,13 +206,13 @@ fn main() {
                 arm_dense_cutlass_for_gate(true).expect("red arm");
