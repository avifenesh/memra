+            );
+        }
+        let line = t.line("t");
+        assert!(line.contains("top1_changes=2"));
+        assert!(line.contains("kl_ab_max=1.00000000000000000e0"));
+        assert!(line.contains("kl_ba_max=3.00000000000000000e0"));
+    }
+}
