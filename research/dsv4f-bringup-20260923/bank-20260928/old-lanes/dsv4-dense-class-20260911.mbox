+            gpu.prefill_with_cache_chunked(tokens, &mut state, PRIME_WIDTH)
                 .expect("prime");
             assert_eq!(state.pos, tokens.len());
             let c1 = dense_cutlass_counts_for_gate().expect("counts");
@@ -261,9 +264,9 @@ fn main() {
