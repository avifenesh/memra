diff --git a/crates/memra-engine/src/dsv4_gpu.rs b/crates/memra-engine/src/dsv4_gpu.rs
index 546ab9c4ef..9fb1ba68a3 100644
--- a/crates/memra-engine/src/dsv4_gpu.rs
+++ b/crates/memra-engine/src/dsv4_gpu.rs
@@ -25618,3 +25618,114 @@ mod session_plan_tests {
         assert_eq!(over.occupied(), 90);
     }
 }
+
+#[cfg(test)]
+mod argmax_component_tests {
+    use crate::dsv4_ffi as k;
+    use cudarc::driver::{DevicePtr, DevicePtrMut};
+
+    /// The 1024-thread greedy argmax against the 256-thread one on rows without a NaN: unique
+    /// maxima, ties at many positions, constant rows, all minus infinity, signed zeros and
+    /// infinite ties, at lengths around the vocabulary and odd tails; then a rough timing of
+    /// both on a vocabulary row.
+    #[test]
+    #[ignore = "requires an exclusively locked CUDA device; greedy argmax component identity"]
+    fn cuda_argmax_wide_matches_narrow_on_finite_and_infinite_rows() {
+        let gpu = memra_runtime::Gpu::new(0).expect("GPU");
+        let stream = gpu.stream();
+        let mut rng = 0x9e3779b97f4a7c15u64;
+        let mut next = move || {
+            rng ^= rng << 13;
+            rng ^= rng >> 7;
+            rng ^= rng << 17;
+            rng
+        };
+        let mut cells = 0;
+        for &n in &[129_280usize, 129_281, 129_283, 1_000, 7, 16_391, 4_096] {
+            for pattern in 0..7 {
+                let mut row: Vec<f32> = (0..n)
+                    .map(|_| ((next() % 20_001) as f32 - 10_000.0) / 97.0)
+                    .collect();
+                match pattern {
+                    0 => {}
+                    1 => {
+                        let m = 500.0;
+                        for _ in 0..9 {
+                            let at = (next() as usize) % n;
+                            row[at] = m;
+                        }
+                    }
+                    2 => row.iter_mut().for_each(|x| *x = 1.25),
+                    3 => row.iter_mut().for_each(|x| *x = f32::NEG_INFINITY),
+                    4 => {
+                        row.iter_mut().for_each(|x| *x = -(x.abs()) - 1.0);
+                        for _ in 0..5 {
+                            let at = (next() as usize) % n;
+                            row[at] = if next() % 2 == 0 { 0.0 } else { -0.0 };
+                        }
+                    }
+                    5 => {
+                        for _ in 0..4 {
+                            let at = (next() as usize) % n;
+                            row[at] = f32::INFINITY;
+                        }
+                    }
+                    _ => row
+                        .iter_mut()
+                        .enumerate()
+                        .for_each(|(i, x)| *x = -(i as f32)),
+                }
+                let dev = stream.clone_htod(&row).unwrap();
+                let mut out = stream.alloc_zeros::<i32>(2).unwrap();
+                let v = dev.device_ptr(&stream).0 as *const f32;
+                let o = out.device_ptr_mut(&stream).0 as *mut i32;
+                unsafe {
+                    k::ck(
+                        "argmax wide",
+                        k::memra_dsv4_argmax(v, n as i64, o, stream.cu_stream().cast()),
+                    )
+                    .unwrap();
+                    k::ck(
+                        "argmax narrow",
+                        k::memra_dsv4_argmax_narrow(
+                            v,
+                            n as i64,
+                            o.add(1),
+                            stream.cu_stream().cast(),
+                        ),
+                    )
+                    .unwrap();
+                }
+                let got = stream.clone_dtoh(&out).unwrap();
+                assert_eq!(got[0], got[1], "argmax n={n} pattern={pattern}");
+                cells += 1;
+            }
+        }
+        let n = 129_280usize;
+        let row: Vec<f32> = (0..n).map(|i| ((i * 7919) % 10_007) as f32).collect();
+        let dev = stream.clone_htod(&row).unwrap();
+        let mut out = stream.alloc_zeros::<i32>(1).unwrap();
+        let v = dev.device_ptr(&stream).0 as *const f32;
+        let o = out.device_ptr_mut(&stream).0 as *mut i32;
+        let time = |wide: bool| {
+            stream.synchronize().unwrap();
+            let t0 = std::time::Instant::now();
+            for _ in 0..2_000 {
+                let rc = unsafe {
+                    if wide {
+                        k::memra_dsv4_argmax(v, n as i64, o, stream.cu_stream().cast())
+                    } else {
+                        k::memra_dsv4_argmax_narrow(v, n as i64, o, stream.cu_stream().cast())
+                    }
+                };
+                assert_eq!(rc, 0);
+            }
+            stream.synchronize().unwrap();
+            t0.elapsed().as_secs_f64() * 1e6 / 2_000.0
+        };
+        let (narrow, wide) = (time(false), time(true));
+        println!(
+            "PASS argmax wide == narrow on {cells} rows; vocabulary row {narrow:.2} us narrow, {wide:.2} us wide (stream-serialized, launch included)"
+        );
+    }
+}
