Subject: [PATCH] perf(dsv4): the greedy argmax runs on 1024 threads with
 float4 loads; same pick for every row without a NaN (#710)

Signed-off-by: memra-lane <lane@localhost>
---
 crates/memra-engine/cu/dsv4_gpu.cu  |  72 +++++++++++++++++-
 crates/memra-engine/src/dsv4_ffi.rs |   7 ++
 crates/memra-engine/src/dsv4_gpu.rs | 111 ++++++++++++++++++++++++++++
 docs/KERNELS.md                     |   1 +
 4 files changed, 190 insertions(+), 1 deletion(-)

diff --git a/crates/memra-engine/cu/dsv4_gpu.cu b/crates/memra-engine/cu/dsv4_gpu.cu
index beeac7ef3f..a9a58528e7 100644
--- a/crates/memra-engine/cu/dsv4_gpu.cu
+++ b/crates/memra-engine/cu/dsv4_gpu.cu
@@ -3026,9 +3026,79 @@ extern "C" __global__ void dsv4_argmax_kernel(const float* __restrict__ v, long
     if (tid == 0) out[0] = (int)bi[0];
 }
 
+// The same pick on 1024 threads (memra #710): thread t reads the float4 words t, t + 1024, ...
+// and then the scalar tail, all in ascending index order, and the tree combines as above. The
+// pick is the maximum value's lowest index for any partition, so every row without a NaN gets
+// dsv4_argmax_kernel's answer; a NaN never compares greater and is never replaced once held, so
+// a row holding one can pick differently. One SM keeps four times the loads in flight.
+__global__ void __launch_bounds__(1024) dsv4_argmax_wide_kernel(const float* __restrict__ v,
+                                                                long n, int* __restrict__ out) {
+    MEMRA_PDL_CHAIN_ENTRY();
+    __shared__ float bv[1024];
+    __shared__ long bi[1024];
+    const int tid = threadIdx.x;
+    float best = -INFINITY;
+    long besti = -1;
+    const long n4 = n >> 2;
+    const float4* v4 = reinterpret_cast<const float4*>(v);
+    auto take4 = [&](const float4 a, long base) {
+        const float xs[4] = {a.x, a.y, a.z, a.w};
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+            if (besti < 0 || xs[e] > best) {
+                best = xs[e];
+                besti = base + e;
+            }
+        }
+    };
+    long j = tid;
+    for (; j + 3 * 1024 < n4; j += 4 * 1024) {
+        float4 a[4];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) a[k] = v4[j + (long)k * 1024];
+#pragma unroll
+        for (int k = 0; k < 4; ++k) take4(a[k], (j + (long)k * 1024) * 4);
+    }
+    for (; j < n4; j += 1024) take4(v4[j], j * 4);
+    for (long i = n4 * 4 + tid; i < n; i += 1024) {
+        const float x = v[i];
+        if (besti < 0 || x > best) {
+            best = x;
+            besti = i;
+        }
+    }
+    bv[tid] = best;
+    bi[tid] = besti;
+    __syncthreads();
+    for (int off = 512; off > 0; off >>= 1) {
+        if (tid < off) {
+            bool take = (bi[tid + off] >= 0) &&
+                        (bi[tid] < 0 || bv[tid + off] > bv[tid] ||
+                         (bv[tid + off] == bv[tid] && bi[tid + off] < bi[tid]));
+            if (take) {
+                bv[tid] = bv[tid + off];
+                bi[tid] = bi[tid + off];
+            }
+        }
+        __syncthreads();
+    }
+    if (tid == 0) out[0] = (int)bi[0];
+}
+
+// A 16-byte aligned row takes the 1024-thread kernel, any other the 256-thread one.
 extern "C" int memra_dsv4_argmax(const float* v, long n, int* out, void* stream_v) {
     cudaStream_t stream = (cudaStream_t)stream_v;
-    memra_chain_launch(dsv4_argmax_kernel,1, 256, 0, stream)(v, n, out);
+    if (((uintptr_t)v & 15) == 0)
+        memra_chain_launch(dsv4_argmax_wide_kernel, 1, 1024, 0, stream)(v, n, out);
+    else
+        memra_chain_launch(dsv4_argmax_kernel, 1, 256, 0, stream)(v, n, out);
+    DSV4_ERR();
+    return 0;
+}
+
+// The 256-thread kernel on any row, for the component test that holds the two to one pick.
+extern "C" int memra_dsv4_argmax_narrow(const float* v, long n, int* out, void* stream_v) {
+    memra_chain_launch(dsv4_argmax_kernel, 1, 256, 0, (cudaStream_t)stream_v)(v, n, out);
     DSV4_ERR();
     return 0;
 }
