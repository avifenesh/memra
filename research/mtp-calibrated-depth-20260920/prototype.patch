+++ b/crates/memra-engine/src/bin/gemma_depth_study.rs
@@ -0,0 +1,284 @@
+//! Gemma native-session twin of dspark-depth-study; full head, current K=5 cap.
+use memra_engine::Engine;
+use memra_engine::gemma_spec::{GemmaDepthExperiment, GemmaDraft};
+use memra_engine::hybrid::HybridModel;
+use memra_engine::learned_depth::LearnedDepth;
+use memra_engine::spec::SpecSampling;
+use memra_gguf::GgufFile;
+use memra_tokenizer::Tokenizer;
+use memra_tokenizer::chat::{ThinkMode, Turn};
+use std::io::Write;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+const K: usize = 5;
+
+fn policy(arm: &str) -> Result<Option<GemmaDepthExperiment>, Box<dyn std::error::Error>> {
+    Ok(match arm {
+        "native" => None,
+        "measured" => Some(GemmaDepthExperiment::MeasuredNative),
+        "learned" => Some(GemmaDepthExperiment::Learned(LearnedDepth::new(
+            (2..=K + 1).collect(),
+            K + 1,
+            16,
+            8,
+        )?)),
+        "fixed" => Some(GemmaDepthExperiment::Learned(LearnedDepth::new(
+            vec![K + 1],
+            K + 1,
+            16,
+            8,
+        )?)),
+        value if value.starts_with("fixed:") => {
+            let k: usize = value[6..].parse()?;
+            if !(1..=K).contains(&k) {
+                return Err("fixed depth outside qualified candidate range".into());
+            }
+            Some(GemmaDepthExperiment::Learned(LearnedDepth::new(
+                vec![k + 1],
+                k + 1,
+                16,
+                8,
+            )?))
+        }
+        _ => return Err("arm must be native|measured|learned|fixed|fixed:K".into()),
+    })
+}
+
+fn render(tok: &Tokenizer, turns: &[Turn]) -> Result<Vec<u32>, Box<dyn std::error::Error>> {
+    let text = tok
+        .apply_chat_template_tools(turns, true, &[], ThinkMode::Default, None)
+        .map_err(|e| format!("chat template: {e}"))?;
+    Ok(tok.encode(&text, true))
+}
+
+fn save_ids(path: &Path, ids: &[u32]) -> std::io::Result<()> {
+    let mut f = std::fs::File::create_new(path)?;
+    for id in ids {
+        writeln!(f, "{id}")?;
+    }
+    Ok(())
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    if !(10..=11).contains(&args.len()) {
+        return Err("usage: gemma-depth-study <target.gguf> <assistant.gguf> <workload> <new-output-dir> <arm> <seed> <max-new> <ctx> <temperature> [gate]".into());
+    }
+    let arm = args[5].as_str();
+    let seed: u64 = args[6].parse()?;
+    let max_new: usize = args[7].parse()?;
+    let ctx: usize = args[8].parse()?;
+    let temperature: f32 = args[9].parse()?;
+    let gate = args.get(10).is_some_and(|v| v == "gate");
+    if args.get(10).is_some() && !gate {
+        return Err("last argument must be gate".into());
+    }
+    if max_new == 0 || !temperature.is_finite() || temperature < 0.0 {
+        return Err("invalid generation length or temperature".into());
+    }
+    let workload = std::fs::read_to_string(&args[3])?;
+    let users: Vec<_> = workload.split("\n---TURN---\n").map(str::trim).collect();
+    if users.len() != 8 || users.iter().any(|s| s.is_empty()) {
+        return Err("workload needs eight nonempty turns".into());
+    }
+    let out = Path::new(&args[4]);
+    std::fs::create_dir(out)?;
+    let mut rows = std::fs::File::create_new(out.join("turns.tsv"))?;
+    writeln!(
+        rows,
+        "turn\tseed\tprompt_tokens\toutput_tokens\telapsed_s\tresumed\tdrafted\taccepted\tpolicy_rounds\tswitches\tcommitted_overshoot"
+    )?;
+    let mut traces = std::fs::File::create_new(out.join("rounds.tsv"))?;
+    writeln!(
+        traces,
+        "turn\tround\tdraft_depth\tcommitted\telapsed_ns\teligible_for_learning"
+    )?;
+    let e = Engine::new(0)?;
+    let gguf = GgufFile::open(&args[1])?;
+    let tok = Tokenizer::from_gguf(&gguf)?;
+    let model = HybridModel::load(&e, &gguf)?;
+    let dg = GgufFile::open(&args[2])?;
+    let mut draft = GemmaDraft::load(&e, &dg)?;
+    if draft.d2t.is_some()
+        || draft.trim_adapt.is_some()
+        || draft.head.out_features() != model.output.out_features()
+        || draft.n_backbone != model.cfg.n_embd as usize
+    {
+        return Err("assistant must have the full target vocabulary and matching backbone geometry, with H off".into());
+    }
+    let eos = tok.eog_ids();
+    let sp = SpecSampling {
+        temp: temperature,
+        seed,
+        top_k: 20,
+        top_p: 0.95,
+        min_p: 0.0,
+        penalty_last_n: 0,
+        penalty_repeat: 1.0,
+        penalty_freq: 0.0,
+        penalty_present: 0.0,
+    };
+    let _ = policy(arm)?;
+    eprintln!(
+        "study family=gemma arm={arm} seed={seed} full_vocab={} draft_cap={K} max_new={max_new} ctx={ctx} temperature={temperature} correctness_only={gate}",
+        model.output.out_features()
+    );
+
+    let warm_prompt = render(&tok, &[Turn { role:"user".into(), content:"Explain how a distributed queue uses acknowledgments, retries, timeouts, deduplication and backpressure. Include failure cases and concrete recovery rules.".into(), ..Default::default() }])?;
+    let warm_started = Instant::now();
+    while warm_started.elapsed() < Duration::from_secs(10) {
+        let mut s = model.gemma_spec_session_new(
+            &e,
+            &mut draft,
+            &warm_prompt,
+            warm_prompt.len() + 128,
+            Some(&sp),
+        )?;
+        if temperature == 0.0 {
+            model.gemma_spec_session_burst(&e, &mut draft, &mut s, 32, K, &eos)?;
+        } else {
+            model.gemma_spec_session_burst_sampled(&e, &mut draft, &mut s, 32, K, &eos, &sp)?;
+        }
+        e.stream().synchronize()?;
+    }
+    let conversations = 2usize;
+    let (mut total_tokens, mut total_seconds) = (0usize, 0.0f64);
+    for conversation in 0..conversations {
+        let mut history = Vec::new();
+        let mut carried = policy(arm)?;
+        let mut observed_rounds = 0usize;
+        let sp = SpecSampling {
+            seed: seed.wrapping_add(conversation as u64 * 1_000_003),
+            ..sp
+        };
+        let seed = sp.seed;
+        for (i, user) in users.iter().enumerate() {
+            let turn = conversation * 8 + i + 1;
+            let started = Instant::now();
+            history.push(Turn {
+                role: "user".into(),
+                content: (*user).into(),
+                ..Default::default()
+            });
+            let prompt = render(&tok, &history)?;
+            if prompt.len() + max_new + K + 8 > ctx {
+                return Err(format!("turn {turn} does not fit ctx {ctx}").into());
+            }
+            // This native Gemma API starts a fresh request. The learner alone is carried
+            // across the conversation; model and random state obey the existing request API.
+            let mut sess = model.gemma_spec_session_new(&e, &mut draft, &prompt, ctx, Some(&sp))?;
+            if let Some(p) = carried.clone() {
+                sess.set_depth_experiment(p)?;
+            }
+            let (mut ids, drafted, accepted) = if temperature == 0.0 {
+                model.gemma_spec_session_burst(&e, &mut draft, &mut sess, max_new, K, &eos)?
+            } else {
+                model.gemma_spec_session_burst_sampled(
+                    &e, &mut draft, &mut sess, max_new, K, &eos, &sp,
+                )?
+            };
+            e.stream().synchronize()?;
+            carried = sess.depth_experiment().cloned();
+            let seconds = started.elapsed().as_secs_f64();
+            ids.truncate(max_new);
+            if ids.is_empty()
+                || ids
+                    .iter()
+                    .any(|&id| id as usize >= model.output.out_features())
+            {
+                return Err("empty or out-of-vocabulary generation".into());
+            }
+            if sess.cache.pos != sess.committed.len()
+                || sess.committed.len() < prompt.len() + ids.len()
+                || sess.committed[..prompt.len()] != prompt
+                || sess.committed[prompt.len()..prompt.len() + ids.len()] != ids
+            {
+                return Err("Gemma committed state disagrees with the public token prefix".into());
+            }
+            let overshoot = sess.committed.len() - prompt.len() - ids.len();
+            for r in sess.depth_rounds() {
+                writeln!(
+                    traces,
+                    "{turn}\t{}\t{}\t{}\t{}\t{}",
+                    r.round,
+                    r.draft_depth,
+                    r.committed,
+                    r.elapsed.as_nanos(),
+                    r.eligible_for_learning
+                )?;
+            }
+            observed_rounds += sess.depth_rounds().len();
+            let switches = match &carried {
+                Some(GemmaDepthExperiment::Learned(p)) => p.switches(),
+                _ => 0,
+            };
+            writeln!(
+                rows,
+                "{turn}\t{seed}\t{}\t{}\t{seconds:.9}\tfalse\t{drafted}\t{accepted}\t{}\t{switches}\t{overshoot}",
+                prompt.len(),
+                ids.len(),
+                sess.depth_rounds().len()
+            )?;
+            rows.flush()?;
+            traces.flush()?;
+            save_ids(&out.join(format!("turn-{turn}.prompt.ids")), &prompt)?;
+            save_ids(&out.join(format!("turn-{turn}.output.ids")), &ids)?;
+            let end = ids
+                .iter()
+                .position(|id| eos.contains(id))
+                .unwrap_or(ids.len());
+            let answer = tok.decode_special(&ids[..end], true);
+            std::fs::write(out.join(format!("turn-{turn}.answer.txt")), &answer)?;
+            history.push(Turn {
+                role: "assistant".into(),
+                content: answer,
+                ..Default::default()
+            });
+            total_tokens += ids.len();
+            total_seconds += seconds;
+            eprintln!(
+                "turn={turn} tokens={} seconds={seconds:.3} switches={switches}",
+                ids.len()
+            );
+        }
+        if arm != "native" && observed_rounds == 0 {
+            return Err("depth instrument did not engage".into());
+        }
+        if let Some(GemmaDepthExperiment::Learned(p)) = &carried {
+            let mut f = std::fs::File::create_new(
+                out.join(format!("depth-stats-{}.tsv", conversation + 1)),
+            )?;
+            writeln!(
+                f,
+                "draft_depth\trounds\ttokens\telapsed_ns\tblocks\tewma_tok_s"
+            )?;
+            for s in p.stats() {
+                writeln!(
+                    f,
+                    "{}\t{}\t{}\t{}\t{}\t{}",
+                    s.depth - 1,
+                    s.rounds,
+                    s.tokens,
+                    s.elapsed.as_nanos(),
+                    s.blocks,
+                    s.ewma_tokens_per_second.unwrap_or(0.0)
+                )?;
+            }
+            if arm == "learned" && (p.switches() == 0 || p.stats().iter().any(|s| s.blocks == 0)) {
+                return Err("learner did not exercise every depth".into());
+            }
+        }
+    }
+    if !gate && total_seconds < 60.0 {
+        return Err("run below 60 seconds; unscored short run".into());
+    }
+    let turn_count = 8 * conversations;
+    println!("PERF_METRICS_START");
+    println!(
+        "{{\"scenarios\":{{\"{arm}\":{{\"tokens\":{total_tokens},\"elapsed_s\":{total_seconds:.9},\"e2e_tok_s\":{:.9},\"turns\":{turn_count},\"conversations\":{conversations},\"turns_per_conversation\":8,\"correctness_only\":{gate}}}}}}}",
+        total_tokens as f64 / total_seconds
+    );
+    println!("PERF_METRICS_END");
+    Ok(())
+}
diff --git a/crates/memra-engine/src/bin/mtp_depth_study.rs b/crates/memra-engine/src/bin/mtp_depth_study.rs
