@@ -0,0 +1,387 @@
+//! Full-vocabulary embedded-MTP depth research, Qwen native-session driver.
+use memra_engine::Engine;
+use memra_engine::hybrid::HybridModel;
+use memra_engine::learned_depth::LearnedDepth;
+use memra_engine::spec::MtpDepthExperiment;
+use memra_engine::spec::SpecSampling;
+use memra_gguf::GgufFile;
+use memra_tokenizer::Tokenizer;
+use memra_tokenizer::chat::{ThinkMode, Turn};
+use std::io::Write;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+fn experiment(
+    arm: &str,
+    cap: usize,
+) -> Result<Option<MtpDepthExperiment>, Box<dyn std::error::Error>> {
+    Ok(match arm {
+        "native" => None,
+        "measured" => Some(MtpDepthExperiment::MeasuredNative),
+        "learned" => Some(MtpDepthExperiment::Learned(LearnedDepth::new(
+            (2..=cap + 1).collect(),
+            4,
+            16,
+            8,
+        )?)),
+        "fixed" => Some(MtpDepthExperiment::Learned(LearnedDepth::new(
+            vec![4],
+            4,
+            16,
+            8,
+        )?)),
+        value if value.starts_with("fixed:") => {
+            let k: usize = value[6..].parse()?;
+            if !(1..=cap).contains(&k) {
+                return Err("fixed depth outside qualified candidate range".into());
+            }
+            Some(MtpDepthExperiment::Learned(LearnedDepth::new(
+                vec![k + 1],
+                k + 1,
+                16,
+                8,
+            )?))
+        }
+        _ => return Err("arm must be native|measured|learned|fixed|fixed:K".into()),
+    })
+}
+
+fn render(tok: &Tokenizer, turns: &[Turn]) -> Result<Vec<u32>, Box<dyn std::error::Error>> {
+    let text = tok
+        .apply_chat_template_tools(turns, true, &[], ThinkMode::Default, None)
+        .map_err(|e| format!("chat template: {e}"))?;
+    Ok(tok.encode(&text, true))
+}
+
+fn save_ids(path: &Path, ids: &[u32]) -> std::io::Result<()> {
+    let mut out = std::fs::File::create_new(path)?;
+    for id in ids {
+        writeln!(out, "{id}")?;
+    }
+    Ok(())
+}
+
+/// Qwen's generation prefix already opened `<think>`. Keep reasoning separate
+/// even when generation reaches its length cap before the closing tag.
+fn qwen_assistant_turn(raw: &str) -> Turn {
+    let (reasoning, mut content) = raw.split_once("</think>").unwrap_or((raw, ""));
+    for _ in 0..2 {
+        if let Some(rest) = content.strip_prefix('\n') {
+            content = rest;
+        } else {
+            break;
+        }
+    }
+    Turn {
+        role: "assistant".into(),
+        reasoning: Some(reasoning.into()),
+        content: content.into(),
+        ..Default::default()
+    }
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    if !(10..=11).contains(&args.len()) {
+        return Err("usage: mtp-depth-study <target.gguf> embedded <workload.txt> <new-output-dir> <native|measured|learned|fixed> <seed> <max-new> <ctx> <temperature> [gate]".into());
+    }
+    let arm = args[5].as_str();
+    let seed: u64 = args[6].parse()?;
+    let max_new: usize = args[7].parse()?;
+    let ctx: usize = args[8].parse()?;
+    let temperature: f32 = args[9].parse()?;
+    let gate = args.get(10).is_some_and(|v| v == "gate");
+    if args.get(10).is_some() && !gate {
+        return Err("last argument must be gate".into());
+    }
+    if max_new == 0 || !temperature.is_finite() || temperature < 0.0 {
+        return Err("max-new must be positive and temperature finite and nonnegative".into());
+    }
+    let workload = std::fs::read_to_string(&args[3])?;
+    let user_turns: Vec<_> = workload.split("\n---TURN---\n").map(str::trim).collect();
+    if user_turns.len() != 8 || user_turns.iter().any(|s| s.is_empty()) {
+        return Err("workload must contain eight nonempty turns separated by ---TURN---".into());
+    }
+    let output = Path::new(&args[4]);
+    std::fs::create_dir(output)?;
+    let mut rows = std::fs::File::create_new(output.join("turns.tsv"))?;
+    writeln!(
+        rows,
+        "turn\tseed\tprompt_tokens\toutput_tokens\telapsed_s\tresumed\tdrafted\taccepted\tpolicy_rounds\tswitches\tfinish_reason\tcommitted_overshoot"
+    )?;
+    let mut trace = std::fs::File::create_new(output.join("rounds.tsv"))?;
+    writeln!(
+        trace,
+        "turn\tround\tdraft_depth\temitted\telapsed_ns\teligible_for_learning"
+    )?;
+    let e = Engine::new(0)?;
+    let gguf = GgufFile::open(&args[1])?;
+    let tok = Tokenizer::from_gguf(&gguf)?;
+    if !tok.has_qwen_effort_ladder() {
+        return Err("study requires Qwen's think-open, reasoning-preserving template".into());
+    }
+    let model = HybridModel::load(&e, &gguf)?;
+    if args[2] != "embedded" {
+        return Err("this Qwen study requires the model's embedded MTP head".into());
+    }
+    let mtp = model.mtp.as_ref().ok_or("model has no embedded MTP head")?;
+    let draft_vocab = mtp
+        .shared_head_head
+        .as_ref()
+        .unwrap_or(&model.output)
+        .out_features();
+    if mtp.d2t.is_some() || draft_vocab != model.output.out_features() {
+        return Err("MTP draft and target heads must both use the full vocabulary".into());
+    }
+    let cap = 7;
+    let initial_experiment = experiment(arm, cap)?;
+    let eos = tok.eog_ids();
+    let sampling = SpecSampling {
+        temp: temperature,
+        seed,
+        top_k: 20,
+        top_p: 0.95,
+        min_p: 0.0,
+        penalty_last_n: 0,
+        penalty_repeat: 1.0,
+        penalty_freq: 0.0,
+        penalty_present: 0.0,
+    };
+    eprintln!(
+        "study arm={arm} seed={seed} full_vocab={} draft_vocab={} mtp=embedded draft_cap={cap} fixed_depth=3 max_new={max_new} ctx={ctx} temperature={temperature} mode={}",
+        model.output.out_features(),
+        draft_vocab,
+        if gate {
+            "correctness-only"
+        } else {
+            "measurement"
+        }
+    );
+
+    // Warm the model for at least ten seconds; discard session and learner state.
+    let warm_prompt = render(&tok, &[Turn { role: "user".into(), content: "Explain how a reliable distributed queue uses acknowledgments, retries, timeouts, deduplication, and backpressure. Give several concrete failure cases and discuss their recovery in detail.".into(), ..Default::default() }])?;
+    let warm_start = Instant::now();
+    while warm_start.elapsed() < Duration::from_secs(10) {
+        let mut warm = model.new_session(&e, warm_prompt.len() + 256)?;
+        let _ = model.generate_spec_session_sampled(
+            &e,
+            &mut warm,
+            &warm_prompt,
+            32,
+            cap,
+            Some(sampling),
+            None,
+        )?;
+        e.stream().synchronize()?;
+    }
+
+    let mut history: Vec<Turn> = Vec::new();
+    let mut carried_policy = initial_experiment;
+    let mut total_tokens = 0usize;
+    let mut total_seconds = 0f64;
+    let mut measured_rounds = 0usize;
+    for (index, user) in user_turns.iter().enumerate() {
+        let turn = index + 1;
+        let started = Instant::now();
+        history.push(Turn {
+            role: "user".into(),
+            content: (*user).into(),
+            ..Default::default()
+        });
+        let prompt = render(&tok, &history)?;
+        if prompt.len() < memra_engine::hybrid_forward::PRIME_MIN_T
+            || prompt.len() + max_new + cap + 8 > ctx
+        {
+            return Err(format!("turn {turn}: prompt {} + max-new {max_new} does not fit ctx {ctx}, or is below the prime floor", prompt.len()).into());
+        }
+        // Hold prompt priming constant across depth policies. Native commit
+        // overshoot depends on K; using it to decide reuse also changes the
+        // numeric lineage of later prompts. Keep only learner state across turns.
+        let resumed = false;
+        let mut sess = model.new_session(&e, ctx)?;
+        sess.depth_experiment = carried_policy.clone();
+        let trace_start = sess.depth_rounds.len();
+        let mut on_commit = |chunk: &[u32]| !chunk.iter().any(|id| eos.contains(id));
+        let (mut ids, drafted, accepted) = model.generate_spec_session_sampled(
+            &e,
+            &mut sess,
+            &prompt,
+            max_new,
+            cap,
+            Some(sampling),
+            Some(&mut on_commit),
+        )?;
+        model.spec_flush_pending(&e, &mut sess, Some(sampling))?;
+        ids.truncate(max_new);
+        if let Some(end) = ids.iter().position(|id| eos.contains(id)) {
+            ids.truncate(end + 1);
+        }
+        e.stream().synchronize()?;
+        carried_policy = sess.depth_experiment.clone();
+        let seconds = started.elapsed().as_secs_f64();
+        if ids.is_empty()
+            || ids
+                .iter()
+                .any(|&id| id as usize >= model.output.out_features())
+        {
+            return Err("generation was empty or contained an out-of-vocabulary id".into());
+        }
+        let stop_reason = if eos.contains(ids.last().unwrap()) {
+            "eos"
+        } else if ids.len() == max_new {
+            "length"
+        } else {
+            return Err("generation stopped before its budget without an EOS token".into());
+        };
+        let mut public_tape = prompt.clone();
+        public_tape.extend(&ids);
+        if !sess.committed.starts_with(&public_tape) {
+            return Err("MTP cache does not contain the full published token prefix".into());
+        }
+        let overshoot = sess.committed.len() - public_tape.len();
+        let new_trace = &sess.depth_rounds[trace_start..];
+        for row in new_trace {
+            writeln!(
+                trace,
+                "{turn}\t{}\t{}\t{}\t{}\t{}",
+                row.round,
+                row.draft_depth,
+                row.emitted,
+                row.elapsed.as_nanos(),
+                row.eligible_for_learning
+            )?;
+        }
+        measured_rounds += new_trace.len();
+        let switches = match &carried_policy {
+            Some(MtpDepthExperiment::Learned(p)) => p.switches(),
+            _ => 0,
+        };
+        writeln!(
+            rows,
+            "{turn}\t{seed}\t{}\t{}\t{seconds:.9}\t{resumed}\t{drafted}\t{accepted}\t{}\t{switches}\t{stop_reason}\t{overshoot}",
+            prompt.len(),
+            ids.len(),
+            new_trace.len()
+        )?;
+        rows.flush()?;
+        trace.flush()?;
+        save_ids(&output.join(format!("turn-{turn}.prompt.ids")), &prompt)?;
+        save_ids(&output.join(format!("turn-{turn}.output.ids")), &ids)?;
+        let end = ids
+            .iter()
+            .position(|id| eos.contains(id))
+            .unwrap_or(ids.len());
+        let raw = tok.decode_special(&ids[..end], true);
+        let answer = qwen_assistant_turn(&raw);
+        std::fs::write(output.join(format!("turn-{turn}.raw.txt")), &raw)?;
+        std::fs::write(
+            output.join(format!("turn-{turn}.answer.txt")),
+            &answer.content,
+        )?;
+        std::fs::write(
+            output.join(format!("turn-{turn}.reasoning.txt")),
+            answer.reasoning.as_deref().unwrap_or(""),
+        )?;
+        history.push(answer);
+        total_tokens += ids.len();
+        total_seconds += seconds;
+        eprintln!(
+            "turn={turn} tokens={} seconds={seconds:.3} resumed={resumed} switches={switches}",
+            ids.len()
+        );
+    }
+    if arm != "native" && measured_rounds == 0 {
+        return Err("MTP depth instrument did not engage".into());
+    }
+    if let Some(MtpDepthExperiment::Learned(policy)) = &carried_policy {
+        let mut stats = std::fs::File::create_new(output.join("depth-stats.tsv"))?;
+        writeln!(
+            stats,
+            "verify_rows\trounds\ttokens\telapsed_ns\tblocks\tewma_tok_s"
+        )?;
+        for row in policy.stats() {
+            writeln!(
+                stats,
+                "{}\t{}\t{}\t{}\t{}\t{}",
+                row.depth,
+                row.rounds,
+                row.tokens,
+                row.elapsed.as_nanos(),
+                row.blocks,
+                row.ewma_tokens_per_second.unwrap_or(0.0)
+            )?;
+        }
+        if arm == "learned"
+            && (policy.switches() == 0 || policy.stats().iter().any(|r| r.blocks == 0))
+        {
+            return Err("learned policy did not exercise every candidate depth".into());
+        }
+    }
+    if !gate && total_seconds < 60.0 {
+        return Err(
+            "measurement below 60 seconds; retain as an unscored short run and increase workload"
+                .into(),
+        );
+    }
+    println!("PERF_METRICS_START");
+    println!(
+        "{{\"scenarios\":{{\"{arm}\":{{\"tokens\":{total_tokens},\"elapsed_s\":{total_seconds:.9},\"e2e_tok_s\":{:.9},\"turns\":8,\"correctness_only\":{gate}}}}}}}",
+        total_tokens as f64 / total_seconds
+    );
