+/// Measurement-only hook for research/probehitch-20260812. This patch is never committed:
+/// it places only the maximum rung due immediately before a queued request is handled, so the
+/// receipt can compare the old inline decision with the new busy-boundary decision on real PP-2.
+pub fn arm_probehitch_receipt() {
+    let copies = PEER_RUNTIME_PROBE_CYCLE_COPIES;
+    PEER_BOUNDARY_COPIES.store(copies, Ordering::Relaxed);
+    PEER_RUNTIME_PROBES.store(0, Ordering::Relaxed);
+    for (width_index, deadline) in PEER_RUNTIME_NEXT_PROBE_COPY.iter().enumerate() {
+        let due = if width_index + 1 == PEER_PROBE_TOKEN_WIDTHS.len() {
+            copies
+        } else {
+            copies + (width_index as u64 + 1) * PEER_RUNTIME_PROBE_INTERVAL_COPIES
+        };
+        deadline.store(due, Ordering::Relaxed);
+        PEER_RUNTIME_PROBE_MAX_COST_NS[width_index].store(0, Ordering::Relaxed);
+    }
+    eprintln!("[probehitch-receipt] armed max rung at boundary_copies={copies}");
