# HELP memra_queue_wait_seconds Worker submission to admission, per generation attempt, cumulative and unsampled.
# TYPE memra_queue_wait_seconds histogram
# HELP memra_ttft_seconds Worker submission to first accepted token event, including queue wait, cumulative and unsampled.
# TYPE memra_ttft_seconds histogram
# HELP memra_e2e_seconds Worker submission to successful generation finish, including queue wait, cumulative and unsampled.
# TYPE memra_e2e_seconds histogram
# HELP memra_tpot_seconds Intervals between accepted worker token events within one generation attempt, cumulative and unsampled.
# TYPE memra_tpot_seconds histogram
# HELP memra_prefill_tokens Prompt token count including cache reads, once per admitted generation attempt.
# TYPE memra_prefill_tokens histogram
# HELP memra_completion_tokens Generated token count of successful generation attempts, including length-limited completions.
# TYPE memra_completion_tokens histogram
# HELP memra_cached_tokens_total Prompt tokens restored from cache for admitted hybrid generation attempts.
# TYPE memra_cached_tokens_total counter
