+def read_input(path, *, root=None, binary=True):
+    """Read a regular opened object, preserving contained resolved aliases."""
+    parent = leaf = None
+    try:
+        target = Path(path).resolve()
+        base = Path(root).resolve() if root is not None else target.parent
+        if not target.is_relative_to(base):
+            raise ValueError('coverage input escapes root')
+        relative = target.relative_to(base)
+        if not relative.parts:
+            raise ValueError('coverage input is not a regular file')
+        parent = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        for component in relative.parts[:-1]:
+            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
+            os.close(parent)
+            parent = child
+        info = os.stat(relative.name, dir_fd=parent, follow_symlinks=False)
+        if not stat.S_ISREG(info.st_mode):
+            raise ValueError('coverage input is not a regular file')
+        leaf = os.open(relative.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        if not stat.S_ISREG(os.fstat(leaf).st_mode):
+            raise ValueError('opened coverage input is not a regular file')
+        with os.fdopen(leaf, 'rb' if binary else 'r') as source:
+            leaf = None
+            return source.read()
+    except (OSError, RuntimeError) as error:
+        raise ValueError('coverage input is missing, nonregular or changed during opening') from error
+    finally:
+        if leaf is not None:
+            os.close(leaf)
+        if parent is not None:
+            os.close(parent)
 
 
