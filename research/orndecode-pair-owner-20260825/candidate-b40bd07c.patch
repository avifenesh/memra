+// B=9..16 pair-list owner sweep (lane/ornith-pair-owner, 2026-08-25). This is deliberately
+// NOT the cached CSR-NVFP4 form: a tiny setup kernel orders pair indices by owner expert, then
+// every pair CTA calls expert_dot_g_v on the original GLOBAL row pointer with the exact B<=8
+// decode/dp4a/float/reduction program. Ordering changes only block issue locality; there is no
+// decoded-weight reuse and no cross-pair arithmetic.
+#define MOE_OWNER_MAX_EXPERTS 256
+extern "C" __global__ void moe_pair_owner_order(
+        const int* __restrict__ sel, int* __restrict__ pair_order,
+        int n_expert, int n_pairs) {
+    const int tid = threadIdx.x;
+    __shared__ int counts[MOE_OWNER_MAX_EXPERTS];
+    __shared__ int cursors[MOE_OWNER_MAX_EXPERTS];
+    if (tid < n_expert) {
+        counts[tid] = 0;
+        cursors[tid] = 0;
+    }
+    __syncthreads();
+    if (tid < n_pairs) atomicAdd(&counts[sel[tid]], 1);
+    __syncthreads();
+    if (tid == 0) {
+        int off = 0;
+        for (int ex = 0; ex < n_expert; ex++) {
+            cursors[ex] = off;
+            off += counts[ex];
+        }
+    }
+    __syncthreads();
+    if (tid < n_pairs) {
+        const int ex = sel[tid];
+        const int pos = atomicAdd(&cursors[ex], 1);
+        pair_order[pos] = (ex << 8) | tid;
+    }
+}
+
+extern "C" __global__ void moe_gate_up_silu8_dev_q8_owner(
+        const unsigned long long* __restrict__ table, const int* __restrict__ pair_order,
+        const signed char* __restrict__ aq, const float* __restrict__ ad,
+        float* __restrict__ act,
+        int in_f, int n_ff, int n_expert, int qt_g, int qt_u, long rb_g, long rb_u,
+        const float* __restrict__ macros) {
+    const int p = blockIdx.y;
+    const int packed = pair_order[p];
+    const int q = packed & 0xff;
+    const int ex = packed >> 8;
+    const int lane = threadIdx.x;
+    const int o = blockIdx.x;
+    const int nsb = in_f >> 5;
+    const int tok = q >> 3; // host contract: Ornith top-8 routing
+    const signed char* aqt = aq + (size_t)tok * in_f;
+    const float* adt = ad + (size_t)tok * nsb;
+    const unsigned char* grow = (const unsigned char*)table[ex] + (long)o * rb_g;
+    const unsigned char* urow = (const unsigned char*)table[n_expert + ex] + (long)o * rb_u;
+    float accg = 0.0f, accu = 0.0f;
+    for (int g = lane; g < nsb; g += 32) {
+        const signed char* aqb = aqt + (size_t)g * 32;
+        const float d8 = adt[g];
+        accg += expert_dot_g_v(qt_g, grow, g, aqb, d8);
+        accu += expert_dot_g_v(qt_u, urow, g, aqb, d8);
+    }
+    accg = warp_reduce_sum(accg);
+    accu = warp_reduce_sum(accu);
+    if (lane == 0) {
+        const float g = accg * __ldg(&macros[ex]);
+        act[(size_t)q * n_ff + o] =
+            (g / (1.0f + expf(-g))) * (accu * __ldg(&macros[n_expert + ex]));
+    }
+}
