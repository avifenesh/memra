#!/usr/bin/env bash
# Generated architecture gate wrapper. Re-run tools/generate-arch-gates.py to change it.
#
# The missing-artifact arm used to print SKIP and `exit 0`, which every caller reads as a pass
# (GATE-INTEGRITY-20260819 A-11/A-17). It is now reported, censused and fatal by default; see
# the SKIP CONTRACT comment in tools/arch-gate-templates/b2-geometry.sh.in for the reasoning.
set -uo pipefail

GATE_NAME={{GATE_NAME}}
ARTIFACT_ENV={{ARTIFACT_ENV}}
DEFAULT_ARTIFACT={{DEFAULT_ARTIFACT}}

skip() { # $1 reason
  local reason=$1
  echo "$GATE_NAME: SKIP ($reason)"
  if [ -n "${MEMRA_SKIP_CENSUS:-}" ]; then
    printf '%s\tgate\t%s\t%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$GATE_NAME" "$reason" >> "$MEMRA_SKIP_CENSUS" || {
      echo "$GATE_NAME: FAIL — MEMRA_SKIP_CENSUS=$MEMRA_SKIP_CENSUS is not writable."
      echo "  A census that cannot record is worse than no census. Refusing."
      exit 1
    }
  fi
  if [ "${MEMRA_ARCH_GATE_ALLOW_SKIP:-0}" = 1 ]; then
    echo "$GATE_NAME: skip ACCOUNTED (MEMRA_ARCH_GATE_ALLOW_SKIP=1) — this run proves nothing."
    exit 0
  fi
  echo "$GATE_NAME: FAIL — a skip is not a pass. Stage what is missing, or set"
  echo "  MEMRA_ARCH_GATE_ALLOW_SKIP=1 to account for the skip deliberately."
  exit 77
}

MODEL="${!ARTIFACT_ENV:-}"
[ -n "$MODEL" ] || MODEL="$DEFAULT_ARTIFACT"
[ -f "$MODEL" ] || skip "no artifact at $MODEL; set $ARTIFACT_ENV"

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$HERE"
while [ "$ROOT" != / ] && [ ! -x "$ROOT/tools/chunk-invariance-gate.sh" ]; do
  ROOT="$(dirname "$ROOT")"
done
[ -x "$ROOT/tools/chunk-invariance-gate.sh" ] || {
  echo "$GATE_NAME: FAIL (cannot locate tools/chunk-invariance-gate.sh)"
  exit 1
}
cd "$ROOT" || exit 1
exec tools/chunk-invariance-gate.sh "$MODEL" \
  --label {{LABEL}} \
  --prompts {{PROMPTS}} \
  --chunks {{CHUNKS}} \
  --seam {{SEAM}} \
  --steps {{STEPS}} \
  "$@"
