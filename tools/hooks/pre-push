#!/bin/sh
# Refuses the push if research/tune-data/current-board.json changed but README.md /
# docs/MODELS.md / docs/PERFORMANCE.md weren't regenerated
# to match (tools/update-perf-board.py).
#
# Install once: git config core.hooksPath tools/hooks

set -e
cd "$(git rev-parse --show-toplevel)"

# Captured before any function shadows $1: git hands this hook the remote name/URL there, and
# log_skip() below needs it after its own positional parameters have taken over.
push_remote=${1:-?}

# ---- skip ledger (2026-08-23) ----
# Every escape hatch in this hook PRINTS its use and appends a row here. Printing alone was the
# house pattern (darklanes' SCRUMP_SKIP, and MEMRA_SKIP_PERF_CI below, which until today printed
# nothing at all when used) and it loses the record the moment the terminal scrolls: a push is a
# one-shot event, so "it was announced" and "anyone can find out" are not the same claim.
#
# Each row names WHAT WAS LET THROUGH, not merely that a skip happened — the pushed HEAD for the
# census, the engine files for the perf gate. A row that cannot identify what it waved past is
# not a record.
#
# PER-CLONE, UNDER THE GIT DIR, AND THAT IS THE DESIGN — not an oversight to be "fixed" later.
# The purpose is "the person who did it can be asked about it afterwards", and a file in the git
# dir serves exactly that: it is never committed, never in the way, and survives the session.
# A TRACKED file would be strictly worse: parallel lanes appending to one tracked path race and
# then need a merge strategy, which is the trap the budgets journal already hit (see darklanes,
# two-box product seams). Fleet-wide skip visibility is a different and much larger thing; if it
# is ever wanted, it wants an API fan-out, not a file. Owner-ruled 2026-08-23. Do not promote
# this to a tracked file.
log_skip() {
    # log_skip <gate> <env-that-was-set> <detail>
    _skip_log="$(git rev-parse --git-common-dir)/memra-gate-skips.log"
    printf '%s\t%s\t%s\t%s\tremote=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$push_remote" \
        >> "$_skip_log" || { echo "pre-push: cannot record unqualified/skip state" >&2; return 1; }
    echo "pre-push: skip recorded in $_skip_log" >&2
}

push_commits=$(mktemp "${TMPDIR:-/tmp}/memra-pre-push.XXXXXX")
push_refs=$(mktemp "${TMPDIR:-/tmp}/memra-push-refs.XXXXXX")
trap 'rm -f "$push_commits" "$push_refs"' EXIT HUP INT TERM
while read -r _local_ref local_oid _remote_ref remote_oid
do
    printf '%s %s %s %s\n' "$_local_ref" "$local_oid" "$_remote_ref" "$remote_oid" >> "$push_refs"
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;; # Deleting a ref pushes no commits.
    esac
    case "$remote_oid" in
        *[!0]*)
            # A rewritten topic can be based on commits that are already published through
            # another ref on this same remote (normally origin/main).  remote_oid..local_oid
            # includes those commits even though this push does not introduce them, which made
            # the blob-version boundary gate judge historical main blobs against the topic's
            # final-tree allowlist.  Exclude every commit already reachable on the destination
            # remote while still naming the exact old topic tip passed by Git.
            if git remote get-url "$1" >/dev/null 2>&1; then
                git rev-list "$local_oid" --not "$remote_oid" "--remotes=$1" \
                    >> "$push_commits"
            else
                # A direct URL has no local remote-tracking namespace to consult.
                git rev-list "$remote_oid..$local_oid" >> "$push_commits"
            fi
            ;;
        *)
            # A new remote ref has no left side. Exclude commits already reachable from
            # this remote's tracking refs so only newly-pushed history is inspected.
            git rev-list "$local_oid" --not --remotes="$1" >> "$push_commits"
            ;;
    esac
done
sort -u "$push_commits" -o "$push_commits"

if ! python3 tools/update-perf-board.py --check; then
    echo ""
    echo "pre-push: perf board is stale. Run:"
    echo "    python3 tools/update-perf-board.py"
    echo "and commit the regenerated docs/MODELS.md + docs/PERFORMANCE.md before pushing."
    exit 1
fi

# ---- MEMRA_* flags census (2026-08-23) ----
# main went RED THREE TIMES in one day from a single cause: a lane landed a new MEMRA_* flag
# read with no docs/FLAGS.md row, and ci.yml's "Flags census self-test" step — whose live arm
# requires tools/check-flags.sh green on the checked-out tree — then failed on main, AFTER the
# commit had landed, blocking every lane behind it. 61e99d5337 did it with
# MEMRA_TCOL_OPROJ/_REF/_PROF (repaired by aad51f87bd); d7fed25562 did it with MEMRA_TCOL_FFN
# (run 32603995018, repaired by 42285b047c); two further lanes inherited a red main mid-work and
# each spent a commit fixing someone else's break before their own push could go green.
#
# The census was never wrong. It ran too late — the only local caller was tools/local-ci.sh,
# where it is a WARNING (line 126) behind a cargo build and a GPU, so a docs- or research-only
# lane pushing straight to main never posed the question at all. This is the earliest point that
# intercepts the real path: every push runs this hook, and CLAUDE.md already forbids --no-verify.
#
# UNCONDITIONAL, no changed-file scoping. It costs 0.55 s on this tree (632 reads), so scoping
# would buy nothing and would be wrong twice: a docs-only commit that DELETES a FLAGS row breaks
# the census while touching no crate, and a gate that only fires once it has guessed which files
# matter is exactly the shape that trained the MEMRA_SKIP_PERF_CI habit documented below.
#
# THE CENSUS, not tools/test_check_flags.sh. The self-test is the census's own coverage gate and
# stays CI-only on purpose: its live block is bound to this tree by construction (three named
# flags, census >= 100 names), so it cannot run inside the throwaway repo that
# tools/test_flags_guard.sh uses to prove THIS arm is wired and able to refuse — and a gate whose
# teeth cannot be exercised is the thing that rots. Census blindness also only regresses when
# check-flags.sh itself is edited, which ci.yml and local-ci.sh both still gate. Neither is
# weakened or duplicated here; ci.yml remains the backstop.
#
# ITS ONE GAP, stated rather than papered over: the census reads the WORKTREE, not the commits
# being pushed, so a FLAGS row written on disk but not committed passes here and reds in CI. The
# refusal message says so. Judging HEAD's tree instead needs a second checkout of 36k files per
# push, and that latency is what gets a hook uninstalled.
if [ "${MEMRA_SKIP_FLAGS_CENSUS:-0}" = "1" ]; then
    # Escapable, and ON THE RECORD: printed here AND appended to the skip ledger defined at the
    # top of this file, so the trace outlives the terminal that scrolled away.
    echo "pre-push: MEMRA_* flags census SKIPPED for this push (MEMRA_SKIP_FLAGS_CENSUS=1)" >&2
    log_skip flags-census MEMRA_SKIP_FLAGS_CENSUS=1 "head=$(git rev-parse HEAD)"
elif ! command -v rg >/dev/null 2>&1; then
    # A missing tool cannot answer the question, and blocking every push on a box without
    # ripgrep would make this arm the reason someone unsets core.hooksPath. LOUD, and the
    # server-side census still answers (ci.yml installs rg itself).
    echo "pre-push: WARNING — rg is not on PATH, so the MEMRA_* flags census was SKIPPED." >&2
    echo "          A missing docs/FLAGS.md row will red ci.yml instead of stopping here." >&2
    echo "          Install it: sudo apt-get install ripgrep" >&2
elif ! flags_out=$(tools/check-flags.sh 2>&1); then
    printf '%s\n' "$flags_out" >&2
    echo "" >&2
    echo "pre-push: REFUSED — the MEMRA_* flags census is red (names listed above)." >&2
    echo "    Add a row for each name to docs/FLAGS.md and commit it WITH the read that" >&2
    echo "    introduced it; one prefix row (e.g. MEMRA_TCOL_*) covers a whole family." >&2
    echo "    This is the check that reddened main three times on 2026-08-23 AFTER landing," >&2
    echo "    so every lane behind those commits paid for it — that is what this arm stops." >&2
    echo "    The census reads the WORKTREE: an uncommitted FLAGS row passes here and reds" >&2
    echo "    ci.yml, so commit the row rather than only writing it." >&2
    echo "    Genuine emergency: MEMRA_SKIP_FLAGS_CENSUS=1 git push ... (printed + logged)." >&2
    exit 1
else
    # A green run SAYS SO, like "perf board is up to date" and the boundary arm's match count
    # right beside it. A gate that is silent when it passes is indistinguishable from a gate
    # that has stopped running — the failure mode this whole file keeps arguing against — and
    # the line it echoes is the census's own count, not a claim restated by the hook.
    echo "pre-push: flags census OK — $(printf '%s\n' "$flags_out" | sed -n 's/^check-flags: runtime/runtime/p')"
fi

# ---- releasability censuses (2026-08-23) ----
# Same lesson as the arm above, one layer out: the check existed and ran TOO LATE. On
# 2026-08-22 main became unreleasable and stayed that way for a day — cu/mmq_fp8_blk_stub.cu
# lost ABI parity with cu/mmq_fp8_blk.cu, so sm_89 and sm_90a stopped LINKING, and
# publish.yml's hardcoded crate list went stale against a workspace that had grown two
# members. Neither was discoverable before a tag: ci.yml compiled one arch, and nothing
# compared the publish list to the members. v0.105.0 and v0.106.0 both died of it, and the
# second one permanently consumed six crates.io version numbers.
#
# HERE as well as in ci.yml, unlike the allowlist verifier (45.9 s, CI-only): all three
# censuses together cost 0.15 s on this tree — 0.06 publish + 0.08 stub-ABI + 0.01 arch —
# which is under a third of the flags census above and far under the ~45 s where a pre-push
# arm starts getting hooks uninstalled. At that price the defect should not even be pushable.
# The teeth (tools/test_releasability_census.sh, 12 arms, 0.65 s) stay in ci.yml for the same
# reason the flags self-test does: they need throwaway trees this hook must not build.
#
# No skip switch on purpose. The flags census has one because a docs row can legitimately lag
# a lane's own work; these three answer "can this tree ship at all", and there is no emergency
# in which the right move is to push a tree that cannot. If one ever fires wrongly, fix the
# census — do not add a bypass.
# APPLICABILITY, and why it is not a fail-open. These censuses answer "can THIS WORKSPACE
# ship", so they are scoped to a repo that has one: a root Cargo.toml carrying
# [workspace.package]. Throwaway repos — including the ones tools/test_flags_guard.sh drives a
# real `git push` through to prove the arm above is wired — have no workspace and no tools/
# tree, and refusing there would mean this hook could only be tested by deleting it. The
# fail-closed half is preserved exactly where it matters: if the repo IS the workspace and a
# census script is missing or non-executable, that is someone removing a gate, and it refuses.
# (Found by test_flags_guard.sh arm 6 reddening on this very arm — the fixture catching a change
# to the hook it exists to protect, which is the whole reason it drives a real push.)
if ! grep -q '^\[workspace\.package\]' Cargo.toml 2>/dev/null; then
    echo "pre-push: releasability censuses N/A — no [workspace.package] in Cargo.toml (not the memra workspace)"
else
for census in tools/workspace-publish-census.sh tools/stub-abi-census.py tools/arch-matrix-census.sh; do
    if [ ! -x "$census" ]; then
        echo "pre-push: REFUSED — $census is missing or not executable." >&2
        echo "    This repo IS the memra workspace, so a releasability gate that cannot answer" >&2
        echo "    is a gate someone removed. Fails closed." >&2
        exit 1
    fi
    if ! census_out=$("$census" 2>&1); then
        printf '%s\n' "$census_out" >&2
        echo "" >&2
        echo "pre-push: REFUSED — $census is red (reason above)." >&2
        echo "    This tree could not be released. The two defects these gates were built for:" >&2
        echo "      * a stub cu/*_stub.cu missing a symbol its real twin exports -> sm_89/sm_90a" >&2
        echo "        fail to LINK, and only the release tag matrix would have told you." >&2
        echo "      * publish.yml's crate list missing a publishable workspace member -> a" >&2
        echo "        half-finished crates.io publish that burns the version number for good." >&2
        exit 1
    fi
done
echo "pre-push: releasability censuses OK — publish list, stub ABI, arch matrix"
fi

# ---- docs-registry census (2026-08-30) ----
# Same WHEN-lesson as the flags arm above, for the other registry docs: ci.yml runs
# tools/docs-registry-census.sh as the backstop, and a census that first answers in CI
# answers AFTER landing. A renamed or deleted file leaves a docs/KERNELS.md row pointing
# at nothing, an off-vocabulary support state or an over-60-line docs/ROUTER.md ships
# the same way, and main reds behind the push that did it. Text-only and sub-second
# (rg + git ls-files), so it runs on every push, unconditional like the flags census.
#
# No skip switch, same reasoning as the releasability censuses: a registry row pointing
# at a missing file has no emergency in which pushing it is right. Fix the row or
# restore the file. Scoped to the memra workspace exactly like those censuses, for the
# same two reasons: the registry docs only exist here, and the throwaway repos that
# test_flags_guard.sh drives real pushes through carry neither the docs nor the script.
# Inside the workspace, a missing census is someone removing a gate, and it refuses.
if ! grep -q '^\[workspace\.package\]' Cargo.toml 2>/dev/null; then
    echo "pre-push: docs-registry census N/A: no [workspace.package] in Cargo.toml (not the memra workspace)"
elif ! command -v rg >/dev/null 2>&1; then
    # Same degradation as the flags arm: a box without ripgrep cannot answer the
    # question, and blocking every push there gets the hook uninstalled. LOUD, and
    # ci.yml still answers (it installs rg itself before running the census).
    echo "pre-push: WARNING: rg is not on PATH, so the docs-registry census was SKIPPED." >&2
    echo "          A stale registry row will red ci.yml instead of stopping here." >&2
    echo "          Install it: sudo apt-get install ripgrep" >&2
elif [ ! -x tools/docs-registry-census.sh ]; then
    echo "pre-push: REFUSED: tools/docs-registry-census.sh is missing or not executable." >&2
    echo "    This repo IS the memra workspace, so a registry gate that cannot answer" >&2
    echo "    is a gate someone removed. Fails closed." >&2
    exit 1
elif ! docs_census_out=$(tools/docs-registry-census.sh 2>&1); then
    printf '%s\n' "$docs_census_out" >&2
    echo "" >&2
    echo "pre-push: REFUSED: the docs-registry census is red (violations above)." >&2
    echo "    docs/KERNELS.md rows must point at tracked files, docs/MODELS.md may only" >&2
    echo "    speak the three support states, and docs/ROUTER.md stays at or under 60" >&2
    echo "    lines. Fix the row or restore the file; ci.yml runs the same census." >&2
    exit 1
else
    # A green run SAYS SO, like the arms above, and it says it with the census's own
    # measured counts (2>&1 keeps its WARNING lines in the record too).
    echo "pre-push: docs-registry census OK"
    printf '%s\n' "$docs_census_out" | sed 's/^docs-registry-census: /    /'
fi

# ---- workflow-file census (2026-09-21) ----
# Same WHEN-lesson again, for the workflow files themselves. On 2026-09-21 two merged PRs
# (#592, #590) each added a ci.yml job named portable-suites; each PR's CI was green on its
# own merge ref, main took both, and GitHub refused the file: the push run had ZERO jobs
# ("This run likely failed because of a workflow file issue") and every push and PR after
# it was red at the workflow level. No step in ci.yml can catch that, because ci.yml is the
# file that does not parse; the push is the last place it can be caught, and a lane that
# merges main inherits the duplicate silently (PyYAML's safe_load keeps the last key).
# tools/check-workflow-keys.py walks every .github/workflows/*.yml with the standard library
# only (revuto on #601: PyYAML is not guaranteed on every interpreter this hook runs under, and
# a census that fails for a missing dependency gets uninstalled) and refuses a duplicate
# mapping key at any depth. Exit 1 is a refusal (duplicate, no jobs); exit 2 is "cannot
# answer" (a construct the walker does not model), reported as such, never as a duplicate.
# Sub-second, unconditional, no skip switch: a tree whose workflow GitHub cannot parse has no
# emergency in which pushing it is right. Scoped to the memra workspace like the censuses
# above (the throwaway repos of test_flags_guard.sh carry no workflows). Teeth:
# tools/test_workflow_keys.sh (ci.yml gates job), including the no-PyYAML arm.
if ! grep -q '^\[workspace\.package\]' Cargo.toml 2>/dev/null; then
    echo "pre-push: workflow-file census N/A: no [workspace.package] in Cargo.toml (not the memra workspace)"
elif [ ! -x tools/check-workflow-keys.py ]; then
    echo "pre-push: REFUSED: tools/check-workflow-keys.py is missing or not executable." >&2
    echo "    This repo IS the memra workspace, so a workflow gate that cannot answer" >&2
    echo "    is a gate someone removed. Fails closed." >&2
    exit 1
else
    wf_rc=0
    wf_census_out=$(tools/check-workflow-keys.py 2>&1) || wf_rc=$?
    if [ "$wf_rc" -eq 0 ]; then
        echo "pre-push: workflow-file census OK"
        printf '%s\n' "$wf_census_out" | sed -n 's/^check-workflow-keys: OK: /    /p'
    elif [ "$wf_rc" -eq 1 ]; then
        printf '%s\n' "$wf_census_out" >&2
        echo "" >&2
        echo "pre-push: REFUSED: a workflow file has a duplicate mapping key or no jobs (above)." >&2
        echo "    GitHub refuses the whole file and runs zero jobs; a merge of main that brought" >&2
        echo "    a second job with the same name is the usual cause. Remove one, keep the other." >&2
        exit 1
    else
        printf '%s\n' "$wf_census_out" >&2
        echo "" >&2
        echo "pre-push: REFUSED: the workflow-file census could not answer (exit $wf_rc, above)." >&2
        echo "    Not a duplicate-key verdict: a workflow file uses a construct the stdlib walker" >&2
        echo "    does not model, or the checker itself failed. Fails closed; fix the file or the" >&2
        echo "    checker (tools/check-workflow-keys.py documents its scope)." >&2
        exit 1
    fi
fi

# ---- content-bound native release qualification (#547) ----
# A topic may be explicitly pushed as unqualified development. Main and tag refs
# always require committed native evidence. File mtimes and model-directory presence
# are not evidence, and the retired perf skip cannot authorize qualification.
if [ "${MEMRA_SKIP_PERF_CI:-0}" = "1" ]; then
    echo "pre-push: MEMRA_SKIP_PERF_CI is retired; it cannot waive GPU qualification." >&2
    exit 1
fi
qualification_mode=${MEMRA_RELEASE_QUALIFICATION_MODE:-qualified}
case "$qualification_mode" in
    development)
        if [ "${MEMRA_HARDWARE_GATE:-generic}" != generic ]; then
            echo "pre-push: development mode cannot claim a hardware gate." >&2
            exit 1
        fi
        python3 tools/release_qualification.py push --repo "$(pwd)" --refs-file "$push_refs" --development
        log_skip release-qualification MEMRA_RELEASE_QUALIFICATION_MODE=development \
            "UNQUALIFIED refs=$(tr '\n' ';' < "$push_refs")"
        ;;
    qualified)
        python3 tools/release_qualification.py push --repo "$(pwd)" --refs-file "$push_refs"
        case "${MEMRA_HARDWARE_GATE:-generic}" in
            generic) ;;
            step-pro)
                # Existing Step proof remains an additional model/topology gate. It
                # cannot replace the complete source/build/roster qualification above.
                range=$(tools/push-range.sh "$1")
                [ -n "${MEMRA_STEP_PRO_RECEIPT:-}" ] || { echo "Step PRO receipt required" >&2; exit 1; }
                python3 tools/check_hardware_gate.py --receipt "$MEMRA_STEP_PRO_RECEIPT" \
                    --repo-root "$(pwd)" --base "$range"
                ;;
            *) echo "unknown MEMRA_HARDWARE_GATE" >&2; exit 1 ;;
        esac
        ;;
    *) echo "unknown MEMRA_RELEASE_QUALIFICATION_MODE" >&2; exit 1 ;;
esac

# ---- profile-blob / secret guard (2026-08-06) ----
# nsys full profiles (.nsys-rep/.qdrep/.qdstrm) embed the ENTIRE process environment —
# a committed one leaked a live GH_TOKEN + hosted-provider API key (caught by GitHub push protection,
# scrubbed via filter-repo). Refuse any push whose new commits add one. No override:
# export the kern-sum CSV instead (nsys stats --report cuda_gpu_kern_sum).
blobs=$(
    while IFS= read -r commit
    do
        git diff-tree --no-commit-id --name-only --diff-filter=A -r -m --root \
            --no-renames "$commit"
    done < "$push_commits" |
        grep -E '\.(nsys-rep|qdrep|qdstrm)$' |
        sort -u || true
)
if [ -n "$blobs" ]; then
    echo "pre-push: REFUSED — nsys profile blob(s) in the push range (they capture full env, incl. tokens):"
    echo "$blobs" | sed 's/^/    /'
    echo "Export kern-sum CSVs instead; strip the blob from history before pushing."
    exit 1
fi

# ---- public-boundary policy (2026-08-14) ----
# Refuses the push if any changed blob in the pushed commits matches the private serving
# material or secret/host regexes in tools/public-boundary-policy.toml WITHOUT being
# grandfathered in tools/public-boundary-allowlist.jsonl. The allowlist pins each entry by
# SHA-256 so it cannot silently grow — changing a file forces either an intentional
# allowlist bump (explicit review) or a migration to darklanes.
if ! python3 tools/check-public-boundary.py check --commits-file "$push_commits"; then
    echo ""
    echo "pre-push: public-boundary check failed. Either migrate the new private surface"
    echo "to darklanes or, if grandfathering is deliberate, add the (path, sha256) entry"
    echo "to tools/public-boundary-allowlist.jsonl and re-run the check."
    exit 1
fi
