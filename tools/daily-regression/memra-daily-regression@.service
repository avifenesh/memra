# Daily per-device memra regression (tools/daily-regression.py). Instance = device class
# from tools/change-impact.toml: memra-daily-regression@rtx5090, @gb10, @rtxpro6000.
# Installed by `python3 tools/daily-regression.py install --device <class>`; the timer is
# installed disabled. Per-box overrides (MEMRA_REPO, MEMRA_DAILY_WORK, and on a Spark the
# sparklock unit MEMRA_SPARK_UNIT, which the gb10 lock refuses without) live in
# ~/.config/memra-daily/<class>.env. cargo, nvcc, gh and the device lock command come from
# the user manager's PATH; set PATH in that file on a box where they live elsewhere.
[Unit]
Description=memra daily regression on %i (main's head)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Default PATH for the device-lock commands and toolchains in the home dir (sparklock and
# gpulock live in ~/.local/bin); the per-box env file below overrides it.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/memra-daily/%i.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Modest CPU: the build runs nice 15 with two jobs under the rig build lock
# (tools/cell_evidence.py BUILD_ENV); the unit also yields CPU and I/O to the desktop.
Environment=CARGO_BUILD_JOBS=2
Nice=15
CPUWeight=20
IOWeight=20
ExecStart=/usr/bin/python3 %h/.local/share/memra-daily/daily-regression.py run --device %i --bootstrap
# Build, battery, serve-smoke and the perf A/B, including the device-lock wait.
TimeoutStartSec=8h
